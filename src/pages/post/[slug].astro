---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { allPosts, TOPICS, TOPIC_HUBS, fmtDate, readMinutes } from '../../lib/posts';
import '../../styles/infographics.css';
import { team } from '../../data/team';

export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.map((p) => ({
    params: { slug: p.data.slug },
    props: { post: p, related: posts.filter((q) => q.id !== p.id && q.data.topics.some((t) => p.data.topics.includes(t))).slice(0, 3) },
  }));
}

const { post, related } = Astro.props;
const d = post.data;
const title = `${d.title} | Focus Accountancy`;
const description = d.description || `${d.title}, from the Focus Accountancy team in Bristol.`;
const url = `${site.url}/post/${d.slug}`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description,
  datePublished: d.published,
  dateModified: d.updated || d.published,
  author: { '@type': d.author === 'Focus Accountancy' ? 'Organization' : 'Person', name: d.author },
  publisher: { '@type': 'Organization', name: site.name, url: site.url, logo: { '@type': 'ImageObject', url: `${site.url}/img/logo-schema.png` } },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  ...(d.image ? { image: `${site.url}${d.image}` } : {}),
};
const old = !!d.published && d.published < '2023-01-01';
const hero = d.hero && d.image ? d.hero : undefined;
// Bylines with a team photo get a small avatar in the designed hero.
const AUTHOR_PHOTOS: Record<string, string> = { 'Barry Adams': '/team/barry-adams.jpg', 'Maria Sagastume': '/team/maria-sagastume.jpg' };
const authorPhoto = AUTHOR_PHOTOS[d.author];
// Authority box at the end of the article for bylines that belong to the current team.
const member = team.find((m) => m.name === d.author);
const memberName = member ? [member.name, member.letters].filter(Boolean).join(' ') : '';
---
<Base title={title} description={description} current="/resources" ogImage={d.image || undefined} overlayHeader={!!hero}>
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify(schema)} />
  <article class="post">
    {hero ? (
      <header class="post-hero band band--pattern">
        <div class="container post-hero__grid">
          <div class="post-hero__copy">
            <p class="eyebrow"><a href="/resources">Resources</a>{d.topics.length > 0 && <> · {d.topics.map((t, i) => <><a href={TOPIC_HUBS[t] ?? `/resources/categories/${t}`}>{TOPICS[t] || t}</a>{i < d.topics.length - 1 ? ', ' : ''}</>)}</>}</p>
            <h1>{d.title}</h1>
            {d.description && <p class="post-hero__lead">{d.description}</p>}
            <div class="post-hero__meta">
              {authorPhoto && <img class="post-hero__avatar" src={authorPhoto} alt="" width="44" height="44" />}
              <p>
                <span class="post-hero__author">{d.author}</span>
                <span>{fmtDate(d.published)} · {readMinutes(d.words)} min read</span>
              </p>
            </div>
          </div>
          <div class="post-hero__art">
            <img src={d.image} alt={d.imageAlt || ''} width="1600" height="900" loading="eager" fetchpriority="high" />
          </div>
        </div>
        {hero.stats.length > 0 && (
          <div class="container">
            <ul class="post-hero__stats" aria-label="Key facts">
              {hero.stats.map((st) => <li><strong>{st.value}</strong><span>{st.label}</span></li>)}
            </ul>
          </div>
        )}
      </header>
    ) : (
      <>
        <header class="post__head">
          <div class="container">
            <p class="eyebrow"><a href="/resources">Resources</a>{d.topics.length > 0 && <> · {d.topics.map((t, i) => <><a href={TOPIC_HUBS[t] ?? `/resources/categories/${t}`}>{TOPICS[t] || t}</a>{i < d.topics.length - 1 ? ', ' : ''}</>)}</>}</p>
            <h1>{d.title}</h1>
            <p class="post__meta">
              <span>{d.author}</span>
              <span>{fmtDate(d.published)}</span>
              {d.updated && d.updated !== d.published && <span>Updated {fmtDate(d.updated)}</span>}
              <span>{readMinutes(d.words)} min read</span>
            </p>
          </div>
        </header>
        {d.image && !d.imageInline && (
          <div class="container post__cover"><img src={d.image} alt={d.imageAlt || ''} loading="eager" fetchpriority="high" /></div>
        )}
      </>
    )}
    <div class="container guide post__body">
      <div>
        {old && (
          <p class="post__notice"><strong>Older article.</strong> Rates, thresholds and rules change every tax year. Check the current position with us before acting on anything here.</p>
        )}
        <div class="prose" set:html={d.html} />
        {member && (
          <aside class="approved" aria-label="About the author">
            <div class="approved__media">
              <img class="approved__photo" src={AUTHOR_PHOTOS[member.name] || member.photo.src} alt={`${member.name}, ${member.role} at Focus Accountancy`} width="132" height="132" loading="lazy" />
              <span class="approved__seal" aria-hidden="true">
                <svg viewBox="0 0 20 20" width="22" height="22"><path fill="currentColor" d="M10 1.5 12.2 3.4l2.9-.3.9 2.8 2.5 1.5-1 2.7 1 2.7-2.5 1.5-.9 2.8-2.9-.3L10 18.5l-2.2-1.9-2.9.3-.9-2.8-2.5-1.5 1-2.7-1-2.7 2.5-1.5.9-2.8 2.9.3z"/><path fill="none" stroke="#0a2b00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="m6.6 10.2 2.2 2.2 4.6-4.8"/></svg>
              </span>
            </div>
            <div class="approved__body">
              <p class="approved__kicker">Written and approved by</p>
              <p class="approved__name">{member.name}{member.letters && <span>{member.letters}</span>}</p>
              <p class="approved__role">{member.role}, Focus Accountancy</p>
              {member.name === 'Barry Adams' && (
                <ul class="approved__chips">
                  <li>Chartered Certified Accountant</li>
                  <li>Qualified 1997</li>
                  <li>Founded Focus in 2007</li>
                  <li>Bristol</li>
                </ul>
              )}
              <p class="approved__text">{member.name === 'Barry Adams'
                ? 'Every article under Barry’s name is checked and signed off by him before it goes live, so the figures and advice here reflect how he works with clients.'
                : `Checked and signed off by ${member.name} before it went live.`}</p>
              <p class="approved__actions">
                <a class="btn btn--light" href={site.bookMeeting}>Book a meeting with {member.name.split(' ')[0]}</a>
                <span class="approved__links">
                  <a class="approved__link" href="/about">Meet the team</a>
                  {member.linkedin && <a class="approved__link" href={member.linkedin} rel="noopener" target="_blank">LinkedIn</a>}
                </span>
              </p>
            </div>
          </aside>
        )}
        {d.tags.length > 0 && <p class="post__tags">{d.tags.map((t) => <span>{t}</span>)}</p>}
      </div>
      <aside class="guide__aside">
        <div class="guide__card">
          <p class="eyebrow">Need a hand?</p>
          <h2 class="guide__card-title">Talk it through with us</h2>
          <p class="small">A free, no-obligation meeting, online or at our Bristol office.</p>
          <a class="btn" href={site.bookMeeting}>Book a free meeting</a>
          <p class="small muted guide__card-foot">or call <a href={site.phoneHref}>{site.phone}</a></p>
        </div>
        {related.length > 0 && (
          <div class="guide__card">
            <p class="eyebrow">Related</p>
            <ul class="guide__links">
              {related.map((r) => <li><a href={`/post/${r.data.slug}`}>{r.data.title}</a></li>)}
            </ul>
          </div>
        )}
        <div class="guide__card">
          <p class="eyebrow">More guides</p>
          <ul class="guide__links">
            <li><a href="/taxes">Paying your taxes</a></li>
            <li><a href="/ir35">IR35</a></li>
            <li><a href="/freeagent">FreeAgent help</a></li>
            <li><a href="/pricing">Pricing</a></li>
            <li><a href="/faq">FAQs</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </article>
</Base>

<style is:global>
  .approved { position: relative; overflow: hidden; isolation: isolate; display: grid; grid-template-columns: auto 1fr; gap: clamp(1.25rem, 3vw, 2rem); align-items: center;
    margin-top: clamp(2.5rem, 6vw, 3.5rem); padding: clamp(1.5rem, 4vw, 2.25rem); border-radius: 22px; color: var(--on-dark);
    background: radial-gradient(120% 140% at 0% 0%, var(--green) 0%, var(--green-deep) 45%, var(--green-ink) 100%);
    box-shadow: 0 24px 48px -24px rgba(10, 43, 0, 0.55); }
  .approved::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: repeating-linear-gradient(135deg, rgba(255,255,255,0.035) 0 1px, transparent 1px 22px); }
  .approved::after { content: ''; position: absolute; z-index: -1; right: -90px; top: -90px; width: 260px; height: 260px; border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.12); box-shadow: 0 0 0 28px rgba(255,255,255,0.03), 0 0 0 56px rgba(255,255,255,0.02); }
  .approved p { margin: 0; }
  .approved__media { position: relative; align-self: start; justify-self: start; width: max-content; }
  .approved__photo { display: block; width: clamp(96px, 14vw, 132px); height: clamp(96px, 14vw, 132px); border-radius: 50%; object-fit: cover;
    border: 4px solid #fff; box-shadow: 0 0 0 6px rgba(255,255,255,0.12), 0 12px 24px rgba(0,0,0,0.3); }
  .approved__seal { position: absolute; right: -2px; bottom: 2px; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%;
    background: #c9f0a8; color: #c9f0a8; border: 3px solid var(--green-ink); }
  .approved__seal svg { color: #c9f0a8; }
  .approved__seal svg path:first-child { fill: #c9f0a8; }
  .approved__kicker { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.3rem 0.7rem; border-radius: 999px; background: rgba(201,240,168,0.14);
    color: #c9f0a8; font-size: 0.74rem; font-weight: 650; letter-spacing: 0.1em; text-transform: uppercase; }
  .approved__name { margin-top: 0.7rem !important; font-size: clamp(1.5rem, 1.1rem + 1.2vw, 1.95rem); font-weight: 650; line-height: 1.1; color: #fff; letter-spacing: -0.01em; }
  .approved__name span { margin-left: 0.5rem; padding: 0.15rem 0.45rem; border-radius: 6px; background: #fff; color: var(--green); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.06em; vertical-align: 0.3em; }
  .approved__role { margin-top: 0.3rem !important; color: var(--on-dark-2); font-size: 1rem; }
  .approved__chips { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; margin: 1rem 0 0; padding: 0; }
  .approved__chips li { margin: 0; padding: 0.3rem 0.65rem; border: 1px solid rgba(255,255,255,0.18); border-radius: 999px; font-size: 0.82rem; color: var(--on-dark); background: rgba(255,255,255,0.04); }
  .approved__text { margin-top: 1rem !important; max-width: 58ch; color: var(--on-dark-2); font-size: 0.97rem; line-height: 1.55; }
  .approved__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1.25rem; margin-top: 1.35rem !important; }
  .approved .btn--light, .approved .btn--light:hover { color: var(--green); text-decoration: none; }
  .approved__links { display: inline-flex; gap: 1.1rem; white-space: nowrap; }
  .approved__link { color: #fff; font-weight: 550; font-size: 0.95rem; text-decoration: underline; text-decoration-color: rgba(255,255,255,0.35); text-underline-offset: 4px; }
  .approved__link:hover { text-decoration-color: #fff; color: #fff; }
  @media (max-width: 560px) { .approved { grid-template-columns: 1fr; text-align: left; } }
  .post__head { border-bottom: 1px solid var(--line); padding-block: clamp(2.5rem, 6vw, 4rem) clamp(1.75rem, 4vw, 2.5rem); }
  .post__head h1 { max-width: 22ch; }
  .post__head .eyebrow a { color: inherit; text-decoration: none; }
  .post__head .eyebrow a:hover { text-decoration: underline; }
  .post__meta { display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; margin: 1rem 0 0; color: var(--ink-2); font-size: 0.95rem; }
  .post__meta span:first-child { color: var(--ink); font-weight: 600; }
  .post__cover { padding-top: 2rem; }
  /* Designed hero: deep-green band, title beside the cover, key facts underneath. The fixed header
     sits over it in its light (overlay) state, so the band starts under it. */
  .post-hero { padding-block: clamp(7.5rem, 13vw, 9.5rem) clamp(2.25rem, 5vw, 3.5rem); overflow: hidden; }
  .post-hero__grid { display: grid; gap: clamp(2rem, 4vw, 3.5rem); align-items: center; }
  @media (min-width: 960px) { .post-hero__grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); } }
  .post-hero .eyebrow a { color: inherit; text-decoration: none; }
  .post-hero .eyebrow a:hover { text-decoration: underline; color: #fff; }
  .post-hero h1 { color: #fff; font-size: clamp(2.2rem, 1rem + 2.9vw, 3.4rem); line-height: 1.04; max-width: 20ch; }
  .post-hero__lead { color: var(--on-dark-2); font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem); max-width: 52ch; margin: 0.25rem 0 0; }
  .post-hero__meta { display: flex; align-items: center; gap: 0.85rem; margin-top: 1.75rem; }
  .post-hero__meta p { display: flex; flex-direction: column; gap: 0.1rem; margin: 0; font-size: 0.92rem; color: var(--on-dark-2); }
  .post-hero__author { color: #fff; font-weight: 620; }
  .post-hero__avatar { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; border: 2px solid var(--lime); }
  .post-hero__art { position: relative; }
  .post-hero__art::before { content: ""; position: absolute; inset: 14px -14px -14px 14px; border: 1.5px solid color-mix(in srgb, var(--lime) 45%, transparent); border-radius: var(--radius-lg); }
  .post-hero__art img { position: relative; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius-lg); box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.7); }
  .post-hero__stats { list-style: none; margin: clamp(2.25rem, 5vw, 3.25rem) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); border-top: 1px solid rgba(255, 255, 255, 0.14); }
  .post-hero__stats li { display: flex; flex-direction: column; gap: 0.3rem; padding: 1.25rem 1.5rem 0 0; }
  .post-hero__stats strong { font-family: var(--display); font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.2rem); font-weight: 650; letter-spacing: -0.02em; line-height: 1; color: var(--lime); }
  .post-hero__stats span { font-size: 0.9rem; color: var(--on-dark-2); max-width: 26ch; }
  @media (prefers-reduced-motion: no-preference) {
    .post-hero__copy > * { animation: rise var(--rise-time) var(--ease) both; animation-delay: calc(0.1s + var(--i, 0) * 80ms); }
    .post-hero__copy > :nth-child(2) { --i: 1; }
    .post-hero__copy > :nth-child(3) { --i: 2; }
    .post-hero__copy > :nth-child(4) { --i: 3; }
    .post-hero__art { animation: rise 1.1s var(--ease) 0.25s both; }
    .post-hero__stats { animation: rise var(--rise-time) var(--ease) 0.45s both; }
  }
  .post__cover img { width: 100%; max-height: 520px; object-fit: cover; border-radius: var(--radius); }
  .post__body { padding-top: clamp(2rem, 5vw, 3.5rem); }
  .post__notice { padding: 0.9rem 1.1rem; margin: 0 0 1.75rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); font-size: 0.95rem; color: var(--ink-2); }
  .post__tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2.5rem; }
  .post__tags span { font-size: 0.85rem; padding: 0.3rem 0.7rem; border: 1px solid var(--line); border-radius: 999px; color: var(--ink-2); }
  .prose figure { margin: 1.75rem 0; }
  .prose figure img, .prose img { max-width: 100%; height: auto; border-radius: var(--radius); }
  .prose figcaption { font-size: 0.9rem; color: var(--ink-2); margin-top: 0.5rem; }
  .prose h4 { margin-top: 1.4rem; font-weight: 650; }
  .prose ol { padding-left: 1.4rem; margin: 0 0 1.1em; color: var(--ink-2); }
  /* Tailwind's preflight strips list markers; article lists need them back. */
  .post__body .prose ul { list-style: disc; }
  .post__body .prose ol { list-style: decimal; }
  .prose blockquote { margin: 1.5rem 0; padding: 0.5rem 0 0.5rem 1.25rem; border-left: 3px solid var(--green); color: var(--ink-2); }
  .prose table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.95rem; }
  .prose th, .prose td { text-align: left; padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  .prose th { font-weight: 650; color: var(--ink); }
  .prose hr { border: 0; border-top: 1px solid var(--line); margin: 2rem 0; }
  .prose sup { font-size: 0.75em; }
</style>
