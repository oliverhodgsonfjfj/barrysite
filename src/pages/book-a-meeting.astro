---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import MeetingHosts from '../components/MeetingHosts.astro';
import { site } from '../data/site';

const title = 'Book a free meeting | Focus Accountancy, Bristol';
const description =
  'Book a free, no-obligation 30-minute video call with Barry, Greg or Maria at Focus Accountancy. Pick whoever has a time that suits you.';
---
<Base title={title} description={description} current="/book-a-meeting">
  <PageHero
    eyebrow="Book a free meeting"
    title="Pick a time with Barry, Greg or Maria"
    intro="Every first meeting is a free, no-obligation 30-minute video call. Choose whoever has a time that suits you."
    compact
  />
  <section class="section section--tight">
    <div class="container" data-reveal>
      <MeetingHosts />
      <p class="small muted hosts__note">
        Can't find a time? Call <a href={site.phoneHref}>{site.phone}</a> or email <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
    </div>
  </section>
</Base>
