---
import Base from '../layouts/Base.astro';
import ResourcesShell from '../components/ResourcesShell.astro';
import { allPosts } from '../lib/posts';

const posts = await allPosts();
const title = 'Resources: articles, guides and factsheets | Focus Accountancy';
const description = 'Articles on tax, FreeAgent, IR35, Making Tax Digital and running a small business, plus guides, factsheets and the client portal, from Focus Accountancy in Bristol.';
---
<Base title={title} description={description} current="/resources">
  <ResourcesShell posts={posts} all={posts} />
</Base>
