        .tabs a { position: relative; display: grid; justify-items: center; gap: 0.2rem; padding: 0.45rem 0.2rem; border-radius: 12px; color: #b9cbab; text-decoration: none; font-size: 0.7rem; font-weight: 600; }
        .tabs a[aria-current] { color: #fff; background: rgba(185, 226, 160, 0.14); }
        .tabs svg { width: 22px; height: 22px; }
        .tabs__badge { position: absolute; top: 0.2rem; left: 52%; min-width: 1.15rem; height: 1.15rem; display: grid; place-items: center; padding: 0 0.3rem; border-radius: 999px; background: var(--lime); color: var(--green-ink); font-size: 0.65rem; }
