---
// Focus Studio: the team's content hub. One place to see every piece of content on the site, review
// new articles (Yes / No), follow the publishing lineup, and jump into the site editor (Keystatic, /keystatic)
// to change posts, reviews, the promotion bar and contact details.
// Not linked from the site, noindex (meta + X-Robots-Tag in vercel.json), left out of the sitemap.
// Decisions save through /api/review (api/review.js live; src/admin/dev-review-api.ts on `astro dev`).
// How the lineup works: docs/content-queue.md.
import '@fontsource-variable/libre-franklin';
import '@fontsource-variable/plus-jakarta-sans';
import { getCollection } from 'astro:content';
import { getLineup, ukToday } from '../lib/queue';
import { allPosts, allNews, TOPICS } from '../lib/posts';
import { annotate, dayShort, dayLong, dateShort, monthLabel, weekday, dayNum, monthShort, readMins } from '../lib/review-format';
import decisions from '../data/review-decisions.json';
import promotionData from '../data/promotion.json';
import contact from '../data/contact.json';
import { reviews } from '../data/reviews';

const DEV = import.meta.env.DEV;
const today = ukToday();
const lineup = await getLineup(today);
const posts = await allPosts();
const news = await allNews();
const drafts = (await getCollection('blog')).filter((e) => e.data.draft);
const promotion = promotionData as { enabled: boolean; message: string; linkLabel?: string; link?: string; endDate?: string | null };

const editor = (path: string) => (DEV ? `/keystatic${path}` : null);
const topicNames = (t: string[]) => t.map((x) => TOPICS[x] || x).join(', ');

type Row = {
  id: string; title: string; type: string; source: string; date: string; author: string; topics: string;
  words?: number; status: string; queue?: string; href?: string | null; external?: boolean; search: string;
};
const rows: Row[] = [];
for (const e of lineup) {
  const d = e.item.data;
  rows.push({
    id: `q-${d.slug}`, title: d.title, type: d.kind === 'update' ? 'Refresh' : 'Article', source: d.source === 'Julio' ? 'Julio' : 'SEO team',
    date: e.date, author: d.author, topics: topicNames(d.topics), words: d.words, status: '', queue: d.slug, href: `#/review/${d.slug}`, search: '',
  });
}
for (const p of posts) {
  if (p.id.startsWith('queue-')) continue; // already listed from the lineup
  const d = p.data;
  rows.push({
    id: `p-${d.slug}`, title: d.title, type: 'Article', source: p.id.startsWith('blog/') ? 'Site editor' : d.legacy ? 'Old website' : 'Focus',
    date: d.updated && !d.legacy ? d.updated : d.published, author: d.author, topics: topicNames(d.topics), words: d.words, status: 'live', href: `/post/${d.slug}`, external: true, search: '',
  });
}
for (const e of drafts) {
  rows.push({
    id: `d-${e.id}`, title: e.data.title, type: 'Article', source: 'Site editor', date: e.data.published, author: e.data.author,
    topics: topicNames(e.data.topics), status: 'draft', href: editor(`/collection/blog/item/${e.id}`), search: '',
  });
}
for (const n of news) {
  rows.push({
    id: `n-${n.data.slug}`, title: n.data.title, type: 'News', source: 'News feed', date: n.data.published, author: 'Informanagement',
    topics: '', words: n.data.words, status: 'live', href: `/news/${n.data.slug}`, external: true, search: '',
  });
}
rows.forEach((r) => (r.search = `${r.title} ${r.author} ${r.topics} ${r.source}`.toLowerCase()));
rows.sort((a, b) => b.date.localeCompare(a.date));

const liveArticles = posts.length;
const recent = posts.filter((p) => p.data.published <= today).slice(0, 5);
const upcoming = lineup.filter((e) => e.date >= today).slice(0, 6);
const nextDue = upcoming[0];
const lastDate = lineup.at(-1)?.date ?? today;

const months: { label: string; entries: typeof lineup }[] = [];
for (const e of lineup) {
  const label = monthLabel(e.date);
  if (months.at(-1)?.label !== label) months.push({ label, entries: [] });
  months.at(-1)!.entries.push(e);
}

const yesLabel = (iso: string) => (iso <= today ? 'Yes, publish now' : `Yes, publish ${dayShort(iso)}`);
const volumeLabel = (v?: number | null) => (v ? `, about ${v.toLocaleString('en-GB')} searches a month` : '');
const checkCount = (checks: { status: string }[], s: string) => checks.filter((c) => c.status === s).length;
const sortedChecks = (checks: { status: string; claim: string; note: string; source: string }[]) =>
  [...checks].sort((a, b) => ['check', 'fixed', 'ok'].indexOf(a.status) - ['check', 'fixed', 'ok'].indexOf(b.status));

const clientItems = Object.fromEntries(
  lineup.map((e) => [e.item.data.slug, { date: e.date, day: dayLong(e.date), short: dayShort(e.date), title: e.item.data.title, live: e.live }]),
);
const promoLive = promotion.enabled && promotion.message.trim() !== '' && (!promotion.endDate || promotion.endDate >= today);

const icons: Record<string, string> = {
  overview: '<rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/>',
  review: '<rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/>',
  lineup: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
  content: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8M16 13H8M16 17H8"/>',
  website: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
  external: '<path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>',
  pencil: '<path d="M21.17 6.81a1 1 0 0 0-3.99-3.99L3.84 16.17a2 2 0 0 0-.5.83l-1.32 4.35a.5.5 0 0 0 .62.62l4.35-1.32a2 2 0 0 0 .83-.5z"/>',
  search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
  back: '<path d="m12 19-7-7 7-7M19 12H5"/>',
  plus: '<path d="M5 12h14M12 5v14"/>',
  arrow: '<path d="M5 12h14M13 5l7 7-7 7"/>',
  megaphone: '<path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/>',
  phone: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>',
  star: '<path d="M11.5 2.8a.6.6 0 0 1 1 0l2.6 5.3 5.8.8a.6.6 0 0 1 .3 1l-4.2 4.1 1 5.8a.6.6 0 0 1-.8.6L12 17.7l-5.2 2.7a.6.6 0 0 1-.8-.6l1-5.8L2.8 9.9a.6.6 0 0 1 .3-1l5.8-.8z"/>',
  lock: '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
};
const nav = [
  { id: 'overview', label: 'Overview', href: '#/' },
  { id: 'review', label: 'Review', href: '#/review' },
  { id: 'lineup', label: 'Lineup', href: '#/lineup' },
  { id: 'content', label: 'All content', href: '#/content' },
  { id: 'website', label: 'Website', href: '#/website' },
];
const filters = [
  { id: 'all', label: 'All' },
  { id: 'waiting', label: 'Waiting for you' },
  { id: 'scheduled', label: 'Scheduled' },
  { id: 'live', label: 'Live' },
  { id: 'draft', label: 'Drafts' },
  { id: 'declined', label: 'Turned down' },
];
const types = ['Article', 'Refresh', 'News'];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Studio · Focus Accountancy</title>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta name="theme-color" content="#0b3f00" />
  </head>
  <body class="st">
    <!-- Sign in -->
    <div class="gate" id="gate" hidden>
      <div class="gate__card">
        <img src="/img/logo-header.webp" alt="Focus Accountancy" width="145" height="72" />
        <h1>Welcome to Studio</h1>
        <p>Everything on your website in one place: new articles to approve, what’s going out when, and every page and post that’s live.</p>
        <form id="gate-form" class="gate__form">
          <label for="gate-key">Your access key</label>
          <input id="gate-key" name="key" type="password" autocomplete="current-password" placeholder="Paste the key from Ollie’s email" />
          <button class="btn-primary" type="submit">Open Studio</button>
          <p class="gate__error" id="gate-error" role="alert" hidden></p>
        </form>
        <button class="gate__skip" type="button" id="gate-skip">Look around without signing in</button>
      </div>
    </div>

    <div class="app">
      <!-- Sidebar -->
      <aside class="side">
        <a class="side__brand" href="#/"><img src="/img/logo-header.webp" alt="Focus Accountancy" width="121" height="60" /><span>Studio</span></a>
        <nav class="side__nav" aria-label="Studio">
          {nav.map((n) => (
            <a href={n.href} data-nav={n.id}>
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[n.id]} />
              <span>{n.label}</span>
              {n.id === 'review' && <b class="side__badge" data-count="waiting"></b>}
            </a>
          ))}
        </nav>
        <div class="side__foot">
          {DEV && (
            <a class="side__link" href="/keystatic"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.pencil} /> Site editor</a>
          )}
          <a class="side__link" href="/" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.external} /> View website</a>
          <div class="side__who" id="who"></div>
        </div>
      </aside>

      <main class="main">
        <!-- Overview -->
        <section class="view" data-view="overview">
          <header class="hero">
            <div class="hero__text">
              <p class="hero__date">{dayLong(today)}</p>
              <h1 class="hero__title"><span id="greeting">Hello</span>, Barry</h1>
              <p class="hero__lede" id="hero-lede">
                {nextDue ? <>You have new articles to look at. The next one is due on {dayLong(nextDue.date)}.</> : <>Nothing is waiting for you.</>}
              </p>
              <div class="hero__actions">
                <a class="btn-primary" href="#/review" id="hero-cta">Start reviewing <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.arrow} /></a>
                <a class="btn-ghost" href="#/lineup">See the lineup</a>
              </div>
            </div>
            <div class="hero__progress">
              <div class="ring" id="ring" style="--p:0">
                <svg viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="52" class="ring__track" /><circle cx="60" cy="60" r="52" class="ring__bar" pathLength="100" /></svg>
                <div class="ring__label"><b data-count="reviewed">0</b><span>of {lineup.length} reviewed</span></div>
              </div>
            </div>
          </header>

          <div class="stats">
            <a class="stat stat--amber" href="#/review"><span class="stat__n" data-count="waiting">0</span><span class="stat__l">Waiting for you</span></a>
            <a class="stat" href="#/lineup"><span class="stat__n" data-count="scheduled">0</span><span class="stat__l">Approved and scheduled</span></a>
            <a class="stat" href="#/content"><span class="stat__n" data-count="published">0</span><span class="stat__l">Published from the lineup</span></a>
            <a class="stat" href="#/content"><span class="stat__n">{liveArticles}</span><span class="stat__l">Articles live on the site</span></a>
          </div>

          <div class="grid2">
            <section class="card">
              <header class="card__head"><h2>Coming up</h2><a href="#/lineup">Full lineup</a></header>
              <ol class="mini-line">
                {upcoming.map((e) => (
                  <li>
                    <a href={`#/review/${e.item.data.slug}`}>
                      <span class="datechip"><b>{dayNum(e.date)}</b><span>{monthShort(e.date)}</span></span>
                      <span class="mini-line__text"><span class="mini-line__title">{e.item.data.title}</span><span class="mini-line__meta">{weekday(e.date)} · {e.item.data.kind === 'update' ? 'Refresh' : 'New article'}</span></span>
                      <span class="chip" data-status-for={e.item.data.slug}></span>
                    </a>
                  </li>
                ))}
              </ol>
            </section>

            <section class="card">
              <header class="card__head"><h2>Your website</h2><a href="#/website">Manage</a></header>
              <ul class="glance">
                <li><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.megaphone} /><span><b>Promotion bar</b>{promoLive ? `On: “${promotion.message}”` : 'Off'}</span></li>
                <li><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.phone} /><span><b>Contact details</b>{contact.phone} · {contact.email}</span></li>
                <li><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.star} /><span><b>Client reviews</b>{reviews.length} on the site</span></li>
                <li><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.content} /><span><b>Articles and news</b>{liveArticles} articles · {news.length} news items</span></li>
              </ul>
            </section>
          </div>

          <section class="card">
            <header class="card__head"><h2>Recently published</h2><a href="#/content">All content</a></header>
            <ul class="recent">
              {recent.map((p) => (
                <li><a href={`/post/${p.data.slug}`} target="_blank" rel="noopener"><span>{p.data.title}</span><span class="muted">{dateShort(p.data.published)}</span></a></li>
              ))}
            </ul>
          </section>
        </section>

        <!-- Review -->
        <section class="view view--review" data-view="review" hidden>
          <div class="rq">
            <header class="rq__head">
              <h1>Review</h1>
              <p>Press <b>Yes</b> to publish on the date shown, or <b>No</b> if it shouldn’t go out. Every figure is highlighted so you can check it.</p>
              <div class="seg" role="tablist">
                <button type="button" class="is-on" data-rq-filter="todo">To review <b data-count="waiting">0</b></button>
                <button type="button" data-rq-filter="all">All <b>{lineup.length}</b></button>
              </div>
            </header>
            <ol class="rq__list">
              {lineup.map((e) => (
                <li data-rq={e.item.data.slug}>
                  <a class="rq__item" href={`#/review/${e.item.data.slug}`} data-slug={e.item.data.slug}>
                    <span class="rq__date">{dayShort(e.date)}</span>
                    <span class="rq__title">{e.item.data.title}</span>
                    <span class="rq__meta"><span class="chip" data-status-for={e.item.data.slug}></span>{e.item.data.kind === 'update' && <span class="tag">Refresh</span>}<span>{readMins(e.item.data.words)} min read</span></span>
                  </a>
                </li>
              ))}
            </ol>
            <p class="rq__done" id="rq-done" hidden>You’re all caught up. Everything in the lineup has an answer.</p>
          </div>

          <div class="reader" id="reader">
            <div class="reader__empty" id="reader-empty">
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.review} />
              <h2>Pick an article to read</h2>
              <p>Each one publishes on its own date once you say yes. You can change your mind until it goes live.</p>
            </div>
            {lineup.map((e) => {
              const d = e.item.data;
              const ok = checkCount(d.checks, 'ok');
              const fixed = checkCount(d.checks, 'fixed');
              const check = checkCount(d.checks, 'check');
              const needsTick = d.html.includes('[CONFIRM') || check > 0;
              return (
                <article class="doc" data-article={d.slug} hidden>
                  <a class="doc__back" href="#/review"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.back} /> All articles</a>
                  <p class="doc__eyebrow">{d.kind === 'update' ? 'Refresh of an existing article' : 'New article'} · {dayLong(e.date)} · by {d.author}</p>
                  <h1 class="doc__title">{d.title}</h1>
                  {d.kind === 'update' && (
                    <p class="doc__note">This replaces the article already on your site at <a href={`/post/${d.slug}`} target="_blank" rel="noopener">/post/{d.slug}</a>. The web address stays the same, so it keeps its place in Google.</p>
                  )}
                  <div class="doc__panels">
                    <section class="panel">
                      <h2>Why this one</h2>
                      <p>{d.why}</p>
                      {d.keyword && <p class="panel__small"><b>Search term:</b> “{d.keyword.term}”{volumeLabel(d.keyword.volume)}. <span class="muted">{d.keyword.note}</span></p>}
                      <p class="panel__small muted">Written by {d.source === 'Julio' ? 'Julio' : 'the Focus SEO team'}. {readMins(d.words)} min read. Topics: {topicNames(d.topics) || 'none'}.</p>
                    </section>
                    <section class="panel">
                      <h2>How it looks in Google</h2>
                      <div class="serp">
                        <span class="serp__url">www.focusaccountancy.co.uk › post › {d.slug}</span>
                        <span class="serp__title">{d.title} | Focus Accountancy</span>
                        <span class="serp__desc">{d.description}</span>
                      </div>
                    </section>
                  </div>
                  {d.checks.length > 0 && (
                    <details class="checks" open={check > 0}>
                      <summary>
                        <span>Fact check</span>
                        <span class="checks__pills">
                          {ok > 0 && <span class="pill pill--ok">{ok} checked</span>}
                          {fixed > 0 && <span class="pill pill--fixed">{fixed} corrected</span>}
                          {check > 0 && <span class="pill pill--check">{check} for you to check</span>}
                        </span>
                      </summary>
                      <ul>
                        {sortedChecks(d.checks).map((c) => (
                          <li class={`chk chk--${c.status}`}>
                            <span class="chk__icon" aria-hidden="true">{c.status === 'ok' ? '✓' : c.status === 'fixed' ? '✎' : '?'}</span>
                            <span>
                              <b>{c.status === 'ok' ? 'Checked' : c.status === 'fixed' ? 'Corrected' : 'Please check'}:</b> {c.claim}
                              {c.note && <span class="muted"> {c.note}</span>}
                              {c.source && (c.source.startsWith('http') ? <> <a href={c.source} target="_blank" rel="noopener">Source</a></> : <span class="muted"> ({c.source})</span>)}
                            </span>
                          </li>
                        ))}
                      </ul>
                    </details>
                  )}
                  <div class="doc__body prose" set:html={annotate(d.html)} />
                  <div class="decide" data-decide={d.slug}>
                    <div data-state hidden></div>
                    <div class="decide__form" data-form>
                      {needsTick && (
                        <label class="decide__tick"><input type="checkbox" data-confirm /> I’ve checked everything marked “Please check” (in the article and the fact check) and it’s right</label>
                      )}
                      <div class="decide__no" data-no-box hidden>
                        <label for={`note-${d.slug}`}>What’s wrong with it? (optional, but it helps us fix it)</label>
                        <textarea id={`note-${d.slug}`} rows="3" data-note></textarea>
                      </div>
                      <div class="decide__buttons">
                        <button type="button" class="btn-no" data-action="no">No</button>
                        <button type="button" class="btn-yes" data-action="yes"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>{yesLabel(e.date)}</button>
                      </div>
                      <p class="decide__error" data-error role="alert" hidden></p>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </section>

        <!-- Lineup -->
        <section class="view" data-view="lineup" hidden>
          <header class="page-head">
            <div>
              <h1>Publishing lineup</h1>
              <p>Two articles a week, Tuesday and Thursday mornings, until {dayLong(lastDate)}. An article goes out on its date once you’ve said yes.</p>
            </div>
            <div class="legend"><span class="chip chip--wait">Waiting for you</span><span class="chip chip--yes">Approved</span><span class="chip chip--live">Live</span><span class="chip chip--no">Turned down</span></div>
          </header>
          <div class="timeline">
            {months.map((m) => (
              <section class="tl-month">
                <h2>{m.label}</h2>
                <ol>
                  {m.entries.map((e) => (
                    <li class="tl-item" data-tl={e.item.data.slug}>
                      <span class="datechip datechip--lg"><span>{weekday(e.date)}</span><b>{dayNum(e.date)}</b><span>{monthShort(e.date)}</span></span>
                      <a class="tl-card" href={`#/review/${e.item.data.slug}`}>
                        <span class="tl-card__top"><span class="chip" data-status-for={e.item.data.slug}></span>{e.item.data.kind === 'update' && <span class="tag">Refresh</span>}<span class="muted">{e.item.data.author} · {readMins(e.item.data.words)} min</span></span>
                        <span class="tl-card__title">{e.item.data.title}</span>
                        <span class="tl-card__why">{e.item.data.why}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </section>
            ))}
          </div>
        </section>

        <!-- All content -->
        <section class="view" data-view="content" hidden>
          <header class="page-head">
            <div>
              <h1>All content</h1>
              <p>Every article and news item on your website, plus everything in the lineup.</p>
            </div>
            {DEV && <a class="btn-primary" href="/keystatic/collection/blog/create"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.plus} /> Write an article</a>}
          </header>
          <div class="toolbar">
            <label class="search"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.search} /><input type="search" id="lib-search" placeholder="Search titles, authors, topics" /></label>
            <div class="filters" role="tablist">
              {filters.map((f, i) => <button type="button" class={i === 0 ? 'is-on' : ''} data-lib-filter={f.id}>{f.label} <b data-lib-count={f.id}></b></button>)}
            </div>
            <select id="lib-type" aria-label="Type">
              <option value="">Every type</option>
              {types.map((t) => <option value={t}>{t === 'News' ? 'News feed' : t === 'Refresh' ? 'Refreshes' : 'Articles'}</option>)}
            </select>
          </div>
          <div class="table-wrap">
            <table class="lib">
              <thead><tr><th>Title</th><th>Status</th><th>Type</th><th class="hide-sm">Date</th><th class="hide-md">Author</th><th class="hide-md">Source</th></tr></thead>
              <tbody>
                {rows.map((r) => (
                  <tr data-row data-status={r.status} data-queue={r.queue} data-type={r.type} data-search={r.search} data-href={r.href || ''} data-external={r.external ? '1' : ''}>
                    <td class="lib__title">
                      {r.href ? <a href={r.href} {...(r.external ? { target: '_blank', rel: 'noopener' } : {})}>{r.title}</a> : <span>{r.title}</span>}
                      <span class="lib__sub">{[r.topics, r.words ? `${readMins(r.words)} min read` : ''].filter(Boolean).join(' · ')}</span>
                    </td>
                    <td><span class="chip" data-chip></span></td>
                    <td>{r.type === 'News' ? 'News feed' : r.type}</td>
                    <td class="hide-sm nowrap">{dateShort(r.date)}</td>
                    <td class="hide-md">{r.author}</td>
                    <td class="hide-md muted">{r.source}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="lib__empty" id="lib-empty" hidden>Nothing matches. Try another search or filter.</p>
          </div>
        </section>

        <!-- Website -->
        <section class="view" data-view="website" hidden>
          <header class="page-head">
            <div>
              <h1>Website</h1>
              <p>The parts of the site your team can change: articles, client reviews, the promotion bar and your contact details.</p>
            </div>
          </header>
          {!DEV && (
            <p class="notice"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.lock} /> Editing these opens in the site editor, which isn’t switched on for the live website yet. Until it is, send any changes to Ollie and we’ll make them the same day.</p>
          )}
          <div class="tiles">
            <article class="tile">
              <span class="tile__icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.content} /></span>
              <h2>Articles</h2>
              <p>{liveArticles} live, {drafts.length} {drafts.length === 1 ? 'draft' : 'drafts'} in the editor. Write your own posts here; they go live when you untick “Draft”.</p>
              <div class="tile__actions">
                {DEV ? <><a class="btn-primary sm" href="/keystatic/collection/blog/create">Write an article</a><a class="btn-ghost sm" href="/keystatic/collection/blog">Your drafts</a></> : <a class="btn-ghost sm" href="#/content">See all articles</a>}
              </div>
            </article>
            <article class="tile">
              <span class="tile__icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.star} /></span>
              <h2>Client reviews</h2>
              <p>{reviews.length} reviews on the site. The first three show on the home page. Reviews are always in the client’s own words.</p>
              <ul class="tile__faces">{reviews.slice(0, 5).map((r) => <li>{r.name}</li>)}</ul>
              <div class="tile__actions">{DEV ? <a class="btn-ghost sm" href="/keystatic/collection/reviews">Edit reviews</a> : <a class="btn-ghost sm" href="/reviews" target="_blank" rel="noopener">View on the site</a>}</div>
            </article>
            <article class="tile">
              <span class="tile__icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.megaphone} /></span>
              <h2>Promotion bar <span class={promoLive ? 'chip chip--live' : 'chip chip--off'}>{promoLive ? 'On' : 'Off'}</span></h2>
              <p>{promoLive ? `“${promotion.message}”` : 'A one-line message along the bottom of every page, for deadlines and offers. Nothing is showing right now.'}</p>
              <div class="tile__actions">{DEV && <a class="btn-ghost sm" href="/keystatic/singleton/promotion">Edit the promotion bar</a>}</div>
            </article>
            <article class="tile">
              <span class="tile__icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.phone} /></span>
              <h2>Contact details</h2>
              <dl class="tile__dl"><dt>Phone</dt><dd>{contact.phone}</dd><dt>Email</dt><dd>{contact.email}</dd><dt>Hours</dt><dd>{contact.hours}</dd></dl>
              <div class="tile__actions">{DEV && <a class="btn-ghost sm" href="/keystatic/singleton/contact">Edit contact details</a>}</div>
            </article>
          </div>
        </section>
      </main>

      <!-- Mobile tab bar -->
      <nav class="tabs" aria-label="Studio">
        {nav.map((n) => (
          <a href={n.href} data-nav={n.id}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[n.id]} /><span>{n.id === 'content' ? 'Content' : n.label}</span>{n.id === 'review' && <b class="tabs__badge" data-count="waiting"></b>}</a>
        ))}
      </nav>
    </div>

    <div class="toast" id="toast" role="status" hidden></div>

    <script is:inline define:vars={{ items: clientItems, built: decisions, today, order: lineup.map((e) => e.item.data.slug) }}>
      const KEY_STORE = 'focus-studio-key';
      const OLD_KEY = 'focus-review-key';
      let key = null;
      let readOnly = false;
      let decisions = built || {};
      let rqFilter = 'todo';
      let libFilter = 'all';

      // A link like /studio#k=KEY signs in and is then tidied away.
      const hashParams = new URLSearchParams(location.hash.replace(/^#\/?/, ''));
      try {
        key = hashParams.get('k') || localStorage.getItem(KEY_STORE) || localStorage.getItem(OLD_KEY);
        if (hashParams.get('k')) localStorage.setItem(KEY_STORE, hashParams.get('k'));
      } catch { key = hashParams.get('k'); }
      if (hashParams.get('k')) history.replaceState(null, '', location.pathname + '#/');

      const $ = (s, el = document) => el.querySelector(s);
      const $$ = (s, el = document) => [...el.querySelectorAll(s)];
      const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);

      const STATUS = {
        waiting: ['wait', 'Waiting for you'],
        scheduled: ['yes', 'Approved'],
        publishing: ['yes', 'Going live'],
        live: ['live', 'Live'],
        declined: ['no', 'Turned down'],
        draft: ['off', 'Draft'],
      };
      function statusOf(slug) {
        const d = decisions[slug];
        const it = items[slug];
        if (!d) return 'waiting';
        if (d.decision === 'no') return 'declined';
        if (it.live) return 'live';
        return it.date <= today ? 'publishing' : 'scheduled';
      }
      const setChip = (el, s) => { const [cls, label] = STATUS[s]; el.className = `chip chip--${cls}`; el.textContent = label; };

      function render() {
        const n = { waiting: 0, scheduled: 0, published: 0, reviewed: 0 };
        for (const slug of order) {
          const s = statusOf(slug);
          if (s === 'waiting') n.waiting++; else n.reviewed++;
          if (s === 'scheduled' || s === 'publishing') n.scheduled++;
          if (s === 'live') n.published++;
          $$(`[data-status-for="${slug}"]`).forEach((el) => setChip(el, s));
          const li = $(`[data-rq="${slug}"]`);
          if (li) li.hidden = rqFilter === 'todo' && s !== 'waiting';
          renderDecision(slug, s);
        }
        $$('[data-count]').forEach((el) => {
          const v = n[el.dataset.count];
          el.textContent = v;
          if (el.classList.contains('side__badge') || el.classList.contains('tabs__badge')) el.hidden = !v;
        });
        $('#ring').style.setProperty('--p', order.length ? Math.round((n.reviewed / order.length) * 100) : 0);
        $('#ring').classList.toggle('ring--empty', n.reviewed === 0);
        $('#rq-done').hidden = !(rqFilter === 'todo' && n.waiting === 0);
        const lede = $('#hero-lede');
        const next = order.find((s) => statusOf(s) === 'waiting');
        if (n.waiting === 0) {
          lede.textContent = 'Everything in the lineup has an answer. Approved articles go out on their dates by themselves.';
          $('#hero-cta').firstChild.textContent = 'See what you approved ';
          $('#hero-cta').setAttribute('href', '#/lineup');
        } else {
          lede.textContent = `${n.waiting} ${n.waiting === 1 ? 'article is' : 'articles are'} waiting for your yes or no. The next one is due on ${items[next].day}.`;
          $('#hero-cta').setAttribute('href', `#/review/${next}`);
        }
        renderLibrary();
      }

      function renderDecision(slug, s) {
        const box = $(`[data-decide="${slug}"]`);
        if (!box) return;
        const d = decisions[slug];
        const it = items[slug];
        const state = $('[data-state]', box);
        $('[data-form]', box).hidden = !!d;
        state.hidden = !d;
        if (!d) return;
        const when = new Date(d.at).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' });
        let msg;
        if (s === 'declined') msg = `<b>You said no</b> on ${when}. It won’t be published.${d.note ? ` Your note: “${esc(d.note)}”` : ''}`;
        else if (s === 'live') msg = `<b>Live on your website.</b> <a href="/post/${slug}" target="_blank" rel="noopener">View the article</a>`;
        else if (s === 'publishing') msg = `<b>Approved.</b> It’s going live now; the website takes a minute or two to update.`;
        else msg = `<b>Approved</b> on ${when}. It goes live on ${it.day}.`;
        const undo = s !== 'live' && key && !readOnly ? `<button type="button" class="link" data-action="undo">Change my mind</button>` : '';
        const next = order.find((x) => x !== slug && statusOf(x) === 'waiting');
        const nextBtn = next ? `<a class="btn-primary sm" href="#/review/${next}">Next article</a>` : '';
        state.innerHTML = `<div class="decided decided--${s}"><p>${msg} ${undo}</p>${nextBtn}</div>`;
      }

      function renderLibrary() {
        const q = ($('#lib-search')?.value || '').trim().toLowerCase();
        const type = $('#lib-type')?.value || '';
        const counts = { all: 0, waiting: 0, scheduled: 0, live: 0, draft: 0, declined: 0 };
        let shown = 0;
        for (const tr of $$('[data-row]')) {
          let s = tr.dataset.queue ? statusOf(tr.dataset.queue) : tr.dataset.status;
          const bucket = s === 'publishing' ? 'scheduled' : s;
          setChip($('[data-chip]', tr), s);
          const matchQ = !q || tr.dataset.search.includes(q);
          const matchT = !type || tr.dataset.type === type;
          if (matchQ && matchT) { counts.all++; counts[bucket] = (counts[bucket] || 0) + 1; }
          const show = matchQ && matchT && (libFilter === 'all' || libFilter === bucket);
          tr.hidden = !show;
          if (show) shown++;
        }
        $$('[data-lib-count]').forEach((b) => (b.textContent = counts[b.dataset.libCount] ?? 0));
        $('#lib-empty').hidden = shown > 0;
      }

      // Routing: #/ · #/review · #/review/<slug> · #/lineup · #/content · #/website
      function route() {
        const parts = location.hash.replace(/^#\/?/, '').split('/').filter(Boolean);
        let view = parts[0] || 'overview';
        if (!$(`[data-view="${view}"]`)) view = 'overview';
        let slug = view === 'review' ? decodeURIComponent(parts[1] || '') : '';
        if (view === 'review' && !items[slug]) {
          slug = '';
          if (matchMedia('(min-width: 1100px)').matches) {
            const next = order.find((s) => statusOf(s) === 'waiting') || order[0];
            if (next) return location.replace(`#/review/${next}`);
          }
        }
        $$('[data-view]').forEach((v) => (v.hidden = v.dataset.view !== view));
        $$('[data-nav]').forEach((a) => a.toggleAttribute('aria-current', a.dataset.nav === view));
        $$('[data-article]').forEach((a) => (a.hidden = a.dataset.article !== slug));
        $$('.rq__item').forEach((a) => a.toggleAttribute('aria-current', a.dataset.slug === slug));
        $('#reader-empty').hidden = !!slug;
        document.body.dataset.reading = slug ? '1' : '';
        document.title = `${slug ? items[slug].title : { overview: 'Overview', review: 'Review', lineup: 'Lineup', content: 'All content', website: 'Website' }[view]} · Studio · Focus Accountancy`;
        if (slug) { $('#reader').scrollTop = 0; window.scrollTo(0, 0); $(`[data-rq="${slug}"]`)?.scrollIntoView({ block: 'nearest' }); }
        else window.scrollTo(0, 0);
      }

      async function api(method, body) {
        const res = await fetch('/api/review', {
          method,
          headers: { 'Content-Type': 'application/json', 'X-Review-Key': key || '' },
          body: body ? JSON.stringify(body) : undefined,
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) { const e = new Error(data.error || 'Couldn’t save just now. Please try again.'); e.status = res.status; throw e; }
        return data;
      }

      let toastTimer;
      function toast(html) {
        const t = $('#toast');
        t.innerHTML = html;
        t.hidden = false;
        requestAnimationFrame(() => t.classList.add('is-on'));
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => { t.classList.remove('is-on'); setTimeout(() => (t.hidden = true), 250); }, 4200);
      }

      document.addEventListener('click', async (ev) => {
        const seg = ev.target.closest('[data-rq-filter]');
        if (seg) { rqFilter = seg.dataset.rqFilter; $$('[data-rq-filter]').forEach((b) => b.classList.toggle('is-on', b === seg)); render(); return; }
        const lf = ev.target.closest('[data-lib-filter]');
        if (lf) { libFilter = lf.dataset.libFilter; $$('[data-lib-filter]').forEach((b) => b.classList.toggle('is-on', b === lf)); renderLibrary(); return; }
        const row = ev.target.closest('[data-row]');
        if (row && !ev.target.closest('a') && row.dataset.href) {
          if (row.dataset.external) window.open(row.dataset.href, '_blank', 'noopener'); else location.href = row.dataset.href;
          return;
        }
        const btn = ev.target.closest('[data-action]');
        if (!btn) return;
        const box = btn.closest('[data-decide]');
        const slug = box.dataset.decide;
        const err = $('[data-error]', box);
        err.hidden = true;
        const action = btn.dataset.action;
        if (!key || readOnly) { showGate(); return; }
        if (action === 'yes') {
          const tick = $('[data-confirm]', box);
          if (tick && !tick.checked) {
            err.hidden = false;
            err.textContent = 'Please tick the box to say you’ve checked everything marked “Please check”.';
            tick.closest('label').classList.add('shake');
            setTimeout(() => tick.closest('label').classList.remove('shake'), 500);
            return;
          }
        }
        if (action === 'no') {
          const noBox = $('[data-no-box]', box);
          if (noBox.hidden) { noBox.hidden = false; btn.textContent = 'Send my no'; $('[data-note]', box).focus(); return; }
        }
        const note = action === 'no' ? $('[data-note]', box).value.trim() : '';
        btn.disabled = true;
        const original = btn.innerHTML;
        btn.textContent = 'Saving…';
        try {
          const data = await api('POST', { slug, decision: action, note });
          decisions = data.decisions;
          if (action !== 'no') { $('[data-no-box]', box).hidden = true; $('[data-action="no"]', box).textContent = 'No'; }
          render();
          const it = items[slug];
          if (action === 'yes') toast(`<b>Approved.</b> ${it.date <= today ? 'Going live in a minute or two.' : `Goes live on ${it.day}.`}`);
          if (action === 'no') toast('<b>Turned down.</b> Thanks, we’ll take another look.');
          if (action === 'undo') toast('Reopened. It’s back in your list.');
        } catch (e) {
          if (e.status === 401) { readOnly = true; showGate('That key didn’t work. Use the link from Ollie’s email, or paste the key again.'); }
          err.hidden = false;
          err.textContent = e.message;
        } finally {
          btn.disabled = false;
          if (btn.isConnected && btn.textContent === 'Saving…') btn.innerHTML = original;
        }
      });

      $('#lib-search').addEventListener('input', renderLibrary);
      $('#lib-type').addEventListener('change', renderLibrary);

      // Sign in
      function showGate(msg) {
        $('#gate').hidden = false;
        $('#gate-error').hidden = !msg;
        if (msg) $('#gate-error').textContent = msg;
        setTimeout(() => $('#gate-key').focus(), 50);
      }
      function signedIn() {
        $('#gate').hidden = true;
        $('#who').innerHTML = readOnly || !key
          ? '<button type="button" class="link" id="sign-in">Sign in to approve</button>'
          : '<span class="side__dot"></span> Signed in';
        $('#sign-in')?.addEventListener('click', () => showGate());
      }
      $('#gate-form').addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const val = $('#gate-key').value.trim();
        if (!val) return;
        const prev = key;
        key = val;
        try {
          const data = await api('GET');
          decisions = data.decisions || {};
          try { localStorage.setItem(KEY_STORE, key); } catch {}
          readOnly = false;
          signedIn();
          render();
        } catch (e) {
          key = prev;
          $('#gate-error').hidden = false;
          $('#gate-error').textContent = e.status === 401 ? 'That key isn’t right. Check the email from Ollie and try again.' : e.message;
        }
      });
      $('#gate-skip').addEventListener('click', () => { readOnly = true; signedIn(); });

      const h = new Date().getHours();
      $('#greeting').textContent = h < 12 ? 'Good morning' : h < 18 ? 'Good afternoon' : 'Good evening';

      window.addEventListener('hashchange', route);
      render();
      route();
      if (!key) showGate();
      else {
        signedIn();
        api('GET')
          .then((data) => { decisions = data.decisions || {}; render(); })
          .catch((e) => { if (e.status === 401) { readOnly = true; showGate('That key didn’t work. Use the link from Ollie’s email, or paste the key again.'); } });
      }
    </script>

    <style is:global>
      :root {
        --bg: #f3f4ee; --panel: #ffffff; --line: #e3e5da; --line-2: #d3d6c8;
        --ink: #13200f; --ink-2: #4a5544; --ink-3: #737c6d;
        --green: #105800; --green-deep: #0b3f00; --green-ink: #0a2b00; --sage: #dfe8d6; --sage-2: #eef3e8; --lime: #b9e2a0;
        --amber-bg: #fff3d4; --amber: #7a4b00; --rose-bg: #f6e4e1; --rose: #8a2a1d; --blue-bg: #e4ecf7; --blue: #1e4b80;
        --display: 'Plus Jakarta Sans Variable', 'Plus Jakarta Sans', system-ui, sans-serif;
        --body: 'Libre Franklin Variable', 'Libre Franklin', system-ui, sans-serif;
        --r: 16px; --r-lg: 22px;
        --shadow: 0 1px 2px rgba(19, 32, 15, 0.04), 0 8px 24px -12px rgba(19, 32, 15, 0.12);
        --side: 248px;
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body.st { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.55 var(--body); -webkit-font-smoothing: antialiased; }
      .st a { color: var(--green); }
      .st h1, .st h2, .st h3 { font-family: var(--display); letter-spacing: -0.02em; color: var(--ink); }
      .st svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex: none; }
      .muted { color: var(--ink-3); }
      .nowrap { white-space: nowrap; }
      [hidden] { display: none !important; }

      /* Buttons */
      .btn-primary, .btn-ghost, .btn-yes, .btn-no { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; font: 600 0.95rem/1 var(--body); border-radius: 999px; padding: 0.8rem 1.25rem; text-decoration: none; cursor: pointer; border: 1px solid transparent; transition: background 0.15s, border-color 0.15s, transform 0.1s; min-height: 44px; }
      .btn-primary { background: var(--green); color: #fff !important; }
      .btn-primary:hover { background: var(--green-deep); }
      .btn-ghost { background: var(--panel); color: var(--ink) !important; border-color: var(--line-2); }
      .btn-ghost:hover { border-color: var(--ink-3); }
      .btn-primary:active, .btn-yes:active, .btn-no:active { transform: translateY(1px); }
      .sm { padding: 0.55rem 0.95rem; min-height: 36px; font-size: 0.88rem; }
      .link { background: none; border: 0; padding: 0; font: inherit; color: var(--green); text-decoration: underline; cursor: pointer; }
      :focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }

      /* Chips */
      .chip { display: inline-flex; align-items: center; gap: 0.3rem; font: 650 0.74rem/1 var(--body); padding: 0.32rem 0.6rem; border-radius: 999px; white-space: nowrap; }
      .chip::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; opacity: 0.85; }
      .chip--wait { background: var(--amber-bg); color: var(--amber); }
      .chip--yes { background: var(--sage); color: var(--green-deep); }
      .chip--live { background: var(--green); color: #fff; }
      .chip--no { background: var(--rose-bg); color: var(--rose); }
      .chip--off { background: #eceee6; color: var(--ink-3); }
      .chip:empty { display: none; }
      .tag { font-size: 0.72rem; font-weight: 600; border: 1px solid var(--line-2); border-radius: 999px; padding: 0.15rem 0.5rem; color: var(--ink-2); }

      /* Layout */
      .app { display: grid; grid-template-columns: var(--side) minmax(0, 1fr); min-height: 100vh; }
      .side { position: sticky; top: 0; height: 100vh; display: flex; flex-direction: column; padding: 1.25rem 0.9rem; background: linear-gradient(180deg, #0d4300 0%, #0a2b00 100%); color: #d6e3cc; }
      .side__brand { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; margin: 0 0 1.4rem; padding: 0.55rem 0.7rem 0.55rem 0.8rem; background: #fff; border-radius: 16px; text-decoration: none; box-shadow: 0 6px 18px -10px rgba(0, 0, 0, 0.5); }
      .side__brand img { height: 36px; width: auto; }
      .side__brand span { font: 650 0.78rem var(--display); color: var(--green-deep); background: var(--sage); border-radius: 999px; padding: 0.25rem 0.6rem; letter-spacing: 0.02em; }
      .side__nav { display: grid; gap: 0.2rem; }
      .side__nav a { position: relative; display: flex; align-items: center; gap: 0.75rem; padding: 0.7rem 0.8rem; border-radius: 12px; color: #c9d8be; text-decoration: none; font-weight: 550; font-size: 0.95rem; transition: background 0.15s, color 0.15s; }
      .side__nav a:hover { background: rgba(255, 255, 255, 0.06); color: #fff; }
      .side__nav a[aria-current] { background: rgba(185, 226, 160, 0.14); color: #fff; }
      .side__nav a[aria-current]::before { content: ''; position: absolute; left: -0.9rem; top: 0.55rem; bottom: 0.55rem; width: 3px; border-radius: 0 3px 3px 0; background: var(--lime); }
      .side__badge { margin-left: auto; min-width: 1.5rem; height: 1.5rem; display: grid; place-items: center; padding: 0 0.4rem; border-radius: 999px; background: var(--lime); color: var(--green-ink); font-size: 0.75rem; }
      .side__foot { margin-top: auto; display: grid; gap: 0.15rem; padding-top: 1rem; border-top: 1px solid rgba(255, 255, 255, 0.08); }
      .side__link { display: flex; align-items: center; gap: 0.6rem; padding: 0.55rem 0.8rem; border-radius: 10px; color: #b9cbab !important; text-decoration: none; font-size: 0.88rem; }
      .side__link:hover { background: rgba(255, 255, 255, 0.06); color: #fff !important; }
      .side__who { display: flex; align-items: center; gap: 0.5rem; padding: 0.6rem 0.8rem 0; font-size: 0.82rem; color: #9fb492; }
      .side__who .link { color: var(--lime); }
      .side__dot { width: 7px; height: 7px; border-radius: 50%; background: #6fd34a; box-shadow: 0 0 0 3px rgba(111, 211, 74, 0.2); }
      .main { min-width: 0; padding: clamp(1.25rem, 3vw, 2.5rem) clamp(1rem, 3.5vw, 3rem) 4rem; }
      .view { max-width: 1180px; margin: 0 auto; animation: rise 0.35s cubic-bezier(0.16, 1, 0.3, 1); }
      @keyframes rise { from { transform: translateY(6px); } to { transform: none; } }

      /* Overview */
      .hero { display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: center; padding: clamp(1.5rem, 3.5vw, 2.5rem); border-radius: var(--r-lg); background: radial-gradient(120% 140% at 100% 0%, #1d6a0b 0%, #0d4300 45%, #0a2b00 100%); color: #e6efdf; box-shadow: var(--shadow); overflow: hidden; position: relative; }
      .hero::after { content: ''; position: absolute; right: -60px; bottom: -80px; width: 280px; height: 280px; border-radius: 50%; background: radial-gradient(circle, rgba(185, 226, 160, 0.18), transparent 70%); pointer-events: none; }
      .hero__date { margin: 0 0 0.4rem; font-size: 0.85rem; color: var(--lime); font-weight: 600; letter-spacing: 0.02em; }
      .st .hero__title { margin: 0; color: #fff; font-size: clamp(1.9rem, 1.2rem + 2.4vw, 2.9rem); font-weight: 650; line-height: 1.1; }
      .hero__lede { margin: 0.8rem 0 1.4rem; max-width: 46ch; color: #cfdec4; font-size: 1.05rem; }
      .hero__actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
      .hero .btn-primary { background: var(--lime); color: var(--green-ink) !important; }
      .hero .btn-primary:hover { background: #cdeeb8; }
      .hero .btn-ghost { background: transparent; color: #fff !important; border-color: rgba(255, 255, 255, 0.3); }
      .hero .btn-ghost:hover { border-color: #fff; }
      .ring { position: relative; width: 150px; height: 150px; }
      .ring svg { width: 100%; height: 100%; transform: rotate(-90deg); stroke-width: 0; }
      .ring__track, .ring__bar { fill: none; stroke-width: 10; }
      .ring__track { stroke: rgba(255, 255, 255, 0.12); }
      .ring__bar { stroke: var(--lime); stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: calc(100 - var(--p)); transition: stroke-dashoffset 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
      .ring--empty .ring__bar { opacity: 0; }
      .ring__label { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; }
      .ring__label b { font: 650 2.2rem/1 var(--display); color: #fff; }
      .ring__label span { font-size: 0.78rem; color: #bcd0ae; margin-top: 0.25rem; }
      .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.9rem; margin: 1.1rem 0; }
      .stat { display: grid; gap: 0.3rem; padding: 1.1rem 1.2rem; border-radius: var(--r); background: var(--panel); border: 1px solid var(--line); text-decoration: none; box-shadow: var(--shadow); transition: transform 0.15s, border-color 0.15s; }
      .stat:hover { transform: translateY(-2px); border-color: var(--line-2); }
      .stat__n { font: 650 2rem/1 var(--display); color: var(--ink); letter-spacing: -0.03em; }
      .stat__l { font-size: 0.88rem; color: var(--ink-2); }
      .stat--amber { background: linear-gradient(180deg, #fffaf0, #fff); border-color: #f1dfb3; }
      .stat--amber .stat__n { color: var(--amber); }
      .grid2 { display: grid; grid-template-columns: 1.4fr 1fr; gap: 0.9rem; margin-bottom: 0.9rem; }
      .card { background: var(--panel); border: 1px solid var(--line); border-radius: var(--r); box-shadow: var(--shadow); padding: 1.1rem 1.25rem 1.25rem; }
      .card__head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.6rem; }
      .st .card__head h2 { margin: 0; font-size: 1.05rem; }
      .card__head a { font-size: 0.88rem; font-weight: 600; text-decoration: none; }
      .mini-line { list-style: none; margin: 0; padding: 0; }
      .mini-line a { display: grid; grid-template-columns: auto 1fr auto; gap: 0.9rem; align-items: center; padding: 0.6rem 0.4rem; border-radius: 12px; text-decoration: none; color: var(--ink); }
      .mini-line li + li a { border-top: 1px solid var(--line); border-radius: 0; }
      .mini-line a:hover .mini-line__title { color: var(--green); }
      .mini-line__text { display: grid; min-width: 0; }
      .mini-line__title { font-weight: 600; line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .mini-line__meta { font-size: 0.8rem; color: var(--ink-3); }
      .datechip { display: grid; place-items: center; width: 46px; height: 50px; border-radius: 12px; background: var(--sage-2); border: 1px solid var(--line); line-height: 1; }
      .datechip b { font: 650 1.15rem var(--display); color: var(--green-deep); }
      .datechip span { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-3); font-weight: 650; }
      .datechip--lg { width: 64px; height: 76px; background: var(--panel); box-shadow: var(--shadow); }
      .datechip--lg b { font-size: 1.6rem; }
      .glance { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.2rem; }
      .glance li { display: grid; grid-template-columns: 36px 1fr; gap: 0.7rem; align-items: center; padding: 0.55rem 0; font-size: 0.9rem; color: var(--ink-2); }
      .glance li + li { border-top: 1px solid var(--line); }
      .glance svg { width: 36px; height: 36px; padding: 8px; border-radius: 10px; background: var(--sage-2); color: var(--green); }
      .glance b { display: block; color: var(--ink); font-weight: 600; }
      .glance span { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
      .recent { list-style: none; margin: 0; padding: 0; }
      .recent a { display: flex; justify-content: space-between; gap: 1rem; padding: 0.65rem 0.2rem; text-decoration: none; color: var(--ink); font-weight: 550; }
      .recent li + li a { border-top: 1px solid var(--line); }
      .recent a:hover span:first-child { color: var(--green); }
      .recent .muted { white-space: nowrap; font-weight: 400; font-size: 0.88rem; }

      /* Page heads */
      .page-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 1rem; margin-bottom: 1.4rem; }
      .st .page-head h1 { margin: 0 0 0.3rem; font-size: clamp(1.7rem, 1.3rem + 1.4vw, 2.3rem); }
      .page-head p { margin: 0; color: var(--ink-2); max-width: 60ch; }
      .legend { display: flex; flex-wrap: wrap; gap: 0.4rem; }

      /* Review */
      .view--review { max-width: none; display: grid; grid-template-columns: 340px minmax(0, 1fr); gap: 1.25rem; align-items: start; }
      .rq { position: sticky; top: 1.25rem; max-height: calc(100vh - 2.5rem); display: flex; flex-direction: column; background: var(--panel); border: 1px solid var(--line); border-radius: var(--r-lg); box-shadow: var(--shadow); overflow: hidden; }
      .rq__head { padding: 1.2rem 1.2rem 0.9rem; border-bottom: 1px solid var(--line); }
      .st .rq__head h1 { margin: 0 0 0.3rem; font-size: 1.5rem; }
      .rq__head p { margin: 0 0 0.9rem; font-size: 0.88rem; color: var(--ink-2); }
      .seg { display: inline-flex; padding: 3px; background: var(--bg); border-radius: 999px; border: 1px solid var(--line); }
      .seg button, .filters button { font: 600 0.85rem var(--body); border: 0; background: none; padding: 0.45rem 0.85rem; border-radius: 999px; color: var(--ink-2); cursor: pointer; display: inline-flex; gap: 0.4rem; align-items: center; }
      .seg button b, .filters button b { font-size: 0.75rem; color: var(--ink-3); }
      .seg button.is-on, .filters button.is-on { background: var(--panel); color: var(--ink); box-shadow: 0 1px 3px rgba(19, 32, 15, 0.12); }
      .rq__list { list-style: none; margin: 0; padding: 0.6rem; overflow-y: auto; display: grid; gap: 0.35rem; align-content: start; }
      .rq__item { display: grid; gap: 0.25rem; padding: 0.75rem 0.85rem; border-radius: 14px; text-decoration: none; color: var(--ink); border: 1px solid transparent; transition: background 0.15s, border-color 0.15s; }
      .rq__item:hover { background: var(--sage-2); }
      .rq__item[aria-current] { background: var(--sage-2); border-color: #bcd3a8; box-shadow: inset 3px 0 0 var(--green); }
      .rq__date { font-size: 0.78rem; font-weight: 650; color: var(--ink-3); }
      .rq__title { font-weight: 600; line-height: 1.3; font-size: 0.95rem; }
      .rq__meta { display: flex; flex-wrap: wrap; gap: 0.4rem 0.5rem; align-items: center; font-size: 0.78rem; color: var(--ink-3); }
      .rq__done { margin: 0; padding: 1.5rem 1.2rem; text-align: center; color: var(--ink-2); font-size: 0.92rem; }
      .reader { min-width: 0; }
      .reader__empty { display: grid; justify-items: center; text-align: center; padding: 18vh 1rem; color: var(--ink-2); }
      .reader__empty svg { width: 44px; height: 44px; color: var(--green); stroke-width: 1.4; }
      .doc { position: relative; background: var(--panel); border: 1px solid var(--line); border-radius: var(--r-lg); box-shadow: var(--shadow); padding: clamp(1.25rem, 3.5vw, 3rem) clamp(1.25rem, 4vw, 3.5rem) 0; max-width: 860px; animation: rise 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
      .doc__back { display: none; align-items: center; gap: 0.4rem; font-size: 0.9rem; font-weight: 600; text-decoration: none; margin-bottom: 1rem; }
      .doc__eyebrow { margin: 0; font-size: 0.78rem; font-weight: 650; letter-spacing: 0.06em; text-transform: uppercase; color: var(--green); }
      .st .doc__title { font-size: clamp(1.8rem, 1.2rem + 2vw, 2.6rem); line-height: 1.12; margin: 0.5rem 0 1rem; max-width: 24ch; font-weight: 650; }
      .doc__note { background: var(--sage-2); border-radius: 12px; padding: 0.75rem 0.95rem; font-size: 0.92rem; color: var(--ink-2); }
      .doc__panels { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; margin: 1.2rem 0; }
      .panel { border: 1px solid var(--line); border-radius: 14px; padding: 0.95rem 1rem; background: #fcfdfa; }
      .st .panel h2 { font: 650 0.72rem var(--body); text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); margin: 0 0 0.5rem; }
      .panel p { margin: 0 0 0.5rem; font-size: 0.92rem; color: var(--ink-2); }
      .panel__small { font-size: 0.84rem !important; }
      .serp { display: grid; gap: 0.15rem; font-family: Arial, sans-serif; }
      .serp__url { font-size: 0.78rem; color: #4d5156; }
      .serp__title { font-size: 1.08rem; color: #1a0dab; line-height: 1.3; }
      .serp__desc { font-size: 0.85rem; color: #4d5156; line-height: 1.45; }
      .checks { border: 1px solid var(--line); border-radius: 14px; margin: 0 0 2rem; }
      .checks summary { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; padding: 0.85rem 1rem; cursor: pointer; font-weight: 650; }
      .checks ul { list-style: none; margin: 0; padding: 0 1rem 1rem; display: grid; gap: 0.55rem; font-size: 0.9rem; }
      .checks__pills { display: flex; gap: 0.4rem; flex-wrap: wrap; }
      .pill { font-size: 0.74rem; font-weight: 650; padding: 0.2rem 0.6rem; border-radius: 999px; }
      .pill--ok, .chk--ok .chk__icon { background: var(--sage); color: var(--green-deep); }
      .pill--fixed, .chk--fixed .chk__icon { background: var(--blue-bg); color: var(--blue); }
      .pill--check, .chk--check .chk__icon { background: var(--amber-bg); color: var(--amber); }
      .chk { display: grid; grid-template-columns: 1.6rem 1fr; gap: 0.5rem; align-items: start; color: var(--ink-2); }
      .chk__icon { display: grid; place-items: center; width: 1.5rem; height: 1.5rem; border-radius: 50%; font-size: 0.78rem; font-weight: 700; }

      /* Article body */
      .prose { font-size: 1.06rem; line-height: 1.7; color: var(--ink-2); }
      .prose h2 { font-size: clamp(1.4rem, 1.1rem + 0.8vw, 1.8rem); margin: 2.2rem 0 0.7rem; line-height: 1.2; }
      .prose h3 { font-size: 1.2rem; margin: 1.7rem 0 0.5rem; }
      .prose h4 { font-family: var(--display); margin: 1.4rem 0 0.4rem; color: var(--ink); }
      .prose p { margin: 0 0 1.05em; }
      .prose ul, .prose ol { padding-left: 1.3rem; margin: 0 0 1.1em; }
      .prose li { margin-bottom: 0.35rem; }
      .prose li::marker { color: var(--green); }
      .prose strong { color: var(--ink); }
      .prose a { font-weight: 550; }
      .prose table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.94rem; display: block; overflow-x: auto; }
      .prose th, .prose td { text-align: left; padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--line); vertical-align: top; }
      .prose th { color: var(--ink); background: var(--sage-2); }
      .prose blockquote { margin: 1.5rem 0; padding: 0.4rem 0 0.4rem 1.2rem; border-left: 3px solid var(--green); }
      mark.fig { background: #fff0b3; color: inherit; padding: 0 0.15em; border-radius: 4px; }
      mark.confirm { background: #ffd9a8; color: #6b3500; font-weight: 650; font-size: 0.85em; padding: 0.12em 0.5em; border-radius: 6px; }

      /* Decision bar */
      .decide { position: sticky; bottom: 0; margin: 2.5rem calc(-1 * clamp(1.25rem, 4vw, 3.5rem)) 0; padding: 1rem clamp(1.25rem, 4vw, 3.5rem) 1.1rem; background: rgba(255, 255, 255, 0.94); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-top: 1px solid var(--line); border-radius: 0 0 var(--r-lg) var(--r-lg); }
      .decide__tick { display: flex; gap: 0.6rem; align-items: flex-start; font-size: 0.92rem; margin-bottom: 0.8rem; cursor: pointer; color: var(--ink-2); }
      .decide__tick input { margin-top: 0.2rem; width: 1.15rem; height: 1.15rem; accent-color: var(--green); flex: none; }
      .shake { animation: shake 0.4s; }
      @keyframes shake { 25% { transform: translateX(-4px); } 75% { transform: translateX(4px); } }
      .decide__no { display: grid; gap: 0.35rem; margin-bottom: 0.8rem; font-size: 0.9rem; }
      .decide__no textarea { width: 100%; border: 1px solid var(--line-2); border-radius: 12px; padding: 0.65rem 0.8rem; font: inherit; resize: vertical; }
      .decide__buttons { display: flex; gap: 0.6rem; justify-content: flex-end; }
      .btn-no { background: var(--panel); border-color: var(--line-2); color: var(--rose); padding-inline: 1.5rem; }
      .btn-no:hover { background: #fbf1ef; border-color: #e3c3bd; }
      .btn-yes { background: var(--green); color: #fff; padding-inline: 1.5rem; }
      .btn-yes:hover { background: var(--green-deep); }
      .btn-yes svg { stroke-width: 2.4; }
      .btn-yes:disabled, .btn-no:disabled { opacity: 0.6; cursor: progress; }
      .decide__error { color: var(--rose); font-size: 0.9rem; margin: 0.6rem 0 0; text-align: right; }
      .decided { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; }
      .decided p { margin: 0; font-size: 0.95rem; color: var(--ink-2); }
      .decided--scheduled b, .decided--publishing b, .decided--live b { color: var(--green); }
      .decided--declined b { color: var(--rose); }
      .decided .link { margin-left: 0.4rem; }

      /* Lineup */
      .timeline { display: grid; gap: 1.8rem; }
      .st .tl-month h2 { font: 650 0.8rem var(--body); text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); margin: 0 0 0.8rem; }
      .tl-month ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; position: relative; }
      .tl-month ol::before { content: ''; position: absolute; left: 31px; top: 0.5rem; bottom: 0.5rem; width: 2px; background: var(--line); }
      .tl-item { display: grid; grid-template-columns: 64px 1fr; gap: 1rem; align-items: start; position: relative; }
      .tl-card { display: grid; gap: 0.4rem; padding: 1rem 1.15rem; border-radius: var(--r); background: var(--panel); border: 1px solid var(--line); box-shadow: var(--shadow); text-decoration: none; color: var(--ink); transition: transform 0.15s, border-color 0.15s; }
      .tl-card:hover { transform: translateY(-2px); border-color: var(--line-2); }
      .tl-card__top { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; font-size: 0.82rem; }
      .tl-card__title { font: 650 1.1rem/1.3 var(--display); letter-spacing: -0.01em; }
      .tl-card__why { font-size: 0.9rem; color: var(--ink-2); }

      /* All content */
      .toolbar { display: flex; flex-wrap: wrap; gap: 0.7rem; align-items: center; margin-bottom: 1rem; }
      .search { display: flex; align-items: center; gap: 0.5rem; flex: 1 1 260px; background: var(--panel); border: 1px solid var(--line-2); border-radius: 999px; padding: 0 1rem; min-height: 44px; color: var(--ink-3); }
      .search:focus-within { border-color: var(--green); box-shadow: 0 0 0 3px rgba(16, 88, 0, 0.12); }
      .search input { border: 0; outline: 0; font: inherit; flex: 1; min-width: 0; background: none; color: var(--ink); }
      .filters { display: inline-flex; flex-wrap: wrap; gap: 2px; padding: 3px; background: #e9ebe2; border-radius: 999px; }
      .toolbar select { font: inherit; font-size: 0.9rem; border: 1px solid var(--line-2); border-radius: 999px; padding: 0.55rem 2rem 0.55rem 1rem; background: var(--panel); min-height: 44px; color: var(--ink); }
      .table-wrap { background: var(--panel); border: 1px solid var(--line); border-radius: var(--r); box-shadow: var(--shadow); overflow: hidden; }
      .lib { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
      .lib th { text-align: left; font: 650 0.74rem var(--body); text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-3); padding: 0.8rem 1rem; background: #fafbf7; border-bottom: 1px solid var(--line); position: sticky; top: 0; }
      .lib td { padding: 0.75rem 1rem; border-bottom: 1px solid var(--line); vertical-align: middle; color: var(--ink-2); }
      .lib tr[data-row] { cursor: pointer; transition: background 0.12s; }
      .lib tr[data-row]:hover { background: var(--sage-2); }
      .lib tbody tr:last-child td { border-bottom: 0; }
      .lib__title a, .lib__title > span:first-child { display: block; font-weight: 600; color: var(--ink); text-decoration: none; line-height: 1.35; }
      .lib__title a:hover { color: var(--green); }
      .lib__sub { display: block; font-size: 0.8rem; color: var(--ink-3); margin-top: 0.15rem; }
      .lib__empty { padding: 2.5rem 1rem; text-align: center; color: var(--ink-2); margin: 0; }

      /* Website */
      .notice { display: flex; gap: 0.7rem; align-items: flex-start; padding: 0.9rem 1.1rem; border-radius: 14px; background: var(--panel); border: 1px dashed var(--line-2); color: var(--ink-2); font-size: 0.92rem; margin: 0 0 1rem; }
      .notice svg { color: var(--green); margin-top: 0.15rem; }
      .tiles { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.9rem; }
      .tile { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.3rem 1.35rem; background: var(--panel); border: 1px solid var(--line); border-radius: var(--r); box-shadow: var(--shadow); }
      .tile__icon { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: var(--sage-2); color: var(--green); }
      .tile__icon svg { width: 22px; height: 22px; }
      .st .tile h2 { display: flex; gap: 0.6rem; align-items: center; margin: 0.3rem 0 0; font-size: 1.15rem; }
      .tile p { margin: 0; color: var(--ink-2); font-size: 0.93rem; }
      .tile__faces { display: flex; flex-wrap: wrap; gap: 0.35rem; list-style: none; margin: 0.2rem 0 0; padding: 0; }
      .tile__faces li { font-size: 0.78rem; padding: 0.2rem 0.6rem; border-radius: 999px; background: var(--bg); color: var(--ink-2); }
      .tile__dl { display: grid; grid-template-columns: auto 1fr; gap: 0.3rem 1rem; margin: 0.2rem 0 0; font-size: 0.93rem; }
      .tile__dl dt { color: var(--ink-3); }
      .tile__dl dd { margin: 0; color: var(--ink); font-weight: 550; }
      .tile__actions { margin-top: auto; padding-top: 0.6rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }
      .tile__actions:empty { display: none; }

      /* Sign in */
      .gate { position: fixed; inset: 0; z-index: 50; display: grid; place-items: center; padding: 1.25rem; background: radial-gradient(120% 120% at 80% 0%, #1d6a0b 0%, #0d4300 40%, #08240a 100%); }
      .gate__card { width: min(440px, 100%); background: var(--panel); border-radius: 26px; padding: 2.2rem 2rem 1.6rem; box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.5); text-align: center; animation: rise 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
      .gate__card img { height: 56px; width: auto; }
      .st .gate__card h1 { margin: 1.2rem 0 0.4rem; font-size: 1.7rem; }
      .gate__card > p { margin: 0 0 1.4rem; color: var(--ink-2); font-size: 0.95rem; }
      .gate__form { display: grid; gap: 0.6rem; text-align: left; }
      .gate__form label { font-size: 0.85rem; font-weight: 600; }
      .gate__form input { font: inherit; padding: 0.8rem 1rem; border: 1px solid var(--line-2); border-radius: 12px; min-height: 48px; }
      .gate__form input:focus { outline: none; border-color: var(--green); box-shadow: 0 0 0 3px rgba(16, 88, 0, 0.14); }
      .gate__error { margin: 0; color: var(--rose); font-size: 0.88rem; }
      .gate__skip { margin-top: 1rem; background: none; border: 0; font: inherit; font-size: 0.88rem; color: var(--ink-3); text-decoration: underline; cursor: pointer; }

      /* Toast */
