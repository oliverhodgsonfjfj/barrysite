---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { allNews, fmtDate } from '../../lib/posts';

export async function getStaticPaths() {
  const items = await allNews();
  return items.map((item, i) => ({ params: { slug: item.data.slug }, props: { item, newer: items[i - 1], older: items[i + 1], latest: items.filter((x) => x.id !== item.id).slice(0, 5) } }));
}
const { item, newer, older, latest } = Astro.props;
const d = item.data;
const title = `${d.title} | News | Focus Accountancy`;
const description = d.summary || `${d.title}: tax and business news from Focus Accountancy, Bristol.`;
const schema = {
  '@context': 'https://schema.org', '@type': 'NewsArticle', headline: d.title, description,
  datePublished: d.published, dateModified: d.published,
  author: { '@type': 'Organization', name: site.name }, publisher: { '@type': 'Organization', name: site.name, url: site.url },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${site.url}/news/${d.slug}` },
};
---
<Base title={title} description={description} current="/resources">
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify(schema)} />
  <article class="post">
    <header class="post__head">
      <div class="container">
        <p class="eyebrow"><a href="/news">News</a></p>
        <h1>{d.title}</h1>
        <p class="post__meta"><span>Focus Accountancy</span><time datetime={d.published}>{fmtDate(d.published)}</time></p>
      </div>
    </header>
    <div class="container guide post__body">
      <div>
        {d.image && <figure class="news__cover"><img src={d.image} alt="" loading="eager" fetchpriority="high" /></figure>}
        <div class="prose" set:html={d.html} />
        <nav class="news__pager" aria-label="More news">
          {newer && <a href={`/news/${newer.data.slug}`}>← {newer.data.title}</a>}
          {older && <a href={`/news/${older.data.slug}`}>{older.data.title} →</a>}
        </nav>
      </div>
      <aside class="guide__aside">
        <div class="guide__card">
          <p class="eyebrow">Latest news</p>
          <ul class="guide__links">
            {latest.map((l) => <li><a href={`/news/${l.data.slug}`}>{l.data.title}</a></li>)}
          </ul>
        </div>
        <div class="guide__card">
          <p class="eyebrow">Need a hand?</p>
          <h2 class="guide__card-title">Talk it through with us</h2>
          <p class="small">A free, no-obligation meeting, online or at our Bristol office.</p>
          <a class="btn" href={site.calendly.barry} rel="noopener">Book a free meeting</a>
          <p class="small muted guide__card-foot">or call <a href={site.phoneHref}>{site.phone}</a></p>
        </div>
      </aside>
    </div>
  </article>
</Base>

<style is:global>
  .post__head { border-bottom: 1px solid var(--line); padding-block: clamp(2.5rem, 6vw, 4rem) clamp(1.75rem, 4vw, 2.5rem); }
  .post__head h1 { max-width: 22ch; }
  .post__head .eyebrow a { color: inherit; text-decoration: none; }
  .post__meta { display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; margin: 1rem 0 0; color: var(--ink-2); font-size: 0.95rem; }
  .post__meta span:first-child { color: var(--ink); font-weight: 600; }
  .post__body { padding-top: clamp(2rem, 5vw, 3.5rem); }
  .news__cover { margin: 0 0 2rem; }
  .news__cover img { width: 100%; max-height: 380px; object-fit: cover; border-radius: var(--radius); }
  .news__pager { display: flex; justify-content: space-between; gap: 1.5rem; margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line); font-size: 0.92rem; }
  .news__pager a { max-width: 45%; }
  .prose table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.95rem; }
  .prose th, .prose td { text-align: left; padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  .prose ol { padding-left: 1.4rem; margin: 0 0 1.1em; color: var(--ink-2); }
  .prose blockquote { margin: 1.5rem 0; padding: 0.5rem 0 0.5rem 1.25rem; border-left: 3px solid var(--green); color: var(--ink-2); }
</style>
