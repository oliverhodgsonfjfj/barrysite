---
// The Focus-branded shell for the Keystatic editor at /keystatic. Injected by the `focus-editor`
// integration in astro.config.mjs (dev only for now), so it lives outside src/pages.
import Editor from './Editor';
export const prerender = false;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Site editor · Focus Accountancy</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <style is:global>
      /* Keystatic's accent is its indigo scale; swap it for the Focus greens. */
      html .kui-scheme--light, html.kui-scheme--light, html .kui-scheme--auto, html.kui-scheme--auto {
        --kui-color-scale-indigo1: #fbfdf9;
        --kui-color-scale-indigo2: #f4f8ef;
        --kui-color-scale-indigo3: #eef3e8;
        --kui-color-scale-indigo4: #e2ecd8;
        --kui-color-scale-indigo5: #d4e3c6;
        --kui-color-scale-indigo6: #c1d6ae;
        --kui-color-scale-indigo7: #a6c48c;
        --kui-color-scale-indigo8: #7fa95f;
        --kui-color-scale-indigo9: #105800;
        --kui-color-scale-indigo10: #0b3f00;
        --kui-color-scale-indigo11: #2f6b1c;
        --kui-color-scale-indigo12: #0a2b00;
      }
      html .kui-scheme--dark, html.kui-scheme--dark {
        --kui-color-scale-indigo1: #0f140c;
        --kui-color-scale-indigo2: #141b10;
        --kui-color-scale-indigo3: #1a2614;
        --kui-color-scale-indigo4: #1f3118;
        --kui-color-scale-indigo5: #253d1c;
        --kui-color-scale-indigo6: #2d4a22;
        --kui-color-scale-indigo7: #375a2a;
        --kui-color-scale-indigo8: #446f33;
        --kui-color-scale-indigo9: #4f8a2e;
        --kui-color-scale-indigo10: #5c9a39;
        --kui-color-scale-indigo11: #a6d38a;
        --kui-color-scale-indigo12: #dcf0cf;
      }
      @media (prefers-color-scheme: dark) {
        html .kui-scheme--auto, html.kui-scheme--auto {
          --kui-color-scale-indigo1: #0f140c;
          --kui-color-scale-indigo2: #141b10;
          --kui-color-scale-indigo3: #1a2614;
          --kui-color-scale-indigo4: #1f3118;
          --kui-color-scale-indigo5: #253d1c;
          --kui-color-scale-indigo6: #2d4a22;
          --kui-color-scale-indigo7: #375a2a;
          --kui-color-scale-indigo8: #446f33;
          --kui-color-scale-indigo9: #4f8a2e;
          --kui-color-scale-indigo10: #5c9a39;
          --kui-color-scale-indigo11: #a6d38a;
          --kui-color-scale-indigo12: #dcf0cf;
        }
      }
      html, html [class*='kui-scheme'] {
        --kui-typography-font-family-base: 'Plus Jakarta Sans Variable', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
      body { margin: 0; }
    </style>
  </head>
  <body>
    <Editor client:only="react" />
    <a class="to-studio" href="/studio">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="m12 19-7-7 7-7M19 12H5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      Studio
    </a>
    <style>
      .to-studio { position: fixed; left: 16px; bottom: 16px; z-index: 1000; display: inline-flex; align-items: center; gap: 6px; padding: 9px 14px; border-radius: 999px; background: #0b3f00; color: #fff; font: 600 13px/1 'Plus Jakarta Sans Variable', system-ui, sans-serif; text-decoration: none; box-shadow: 0 8px 24px -8px rgba(0,0,0,.35); }
      .to-studio:hover { background: #105800; }
    </style>
  </body>
</html>
