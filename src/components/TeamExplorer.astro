---
import { Image } from 'astro:assets';
import { team } from '../data/team';
---
<section class="section team-x" aria-labelledby="team-title">
  <div class="container">
    <div class="section__intro" data-reveal>
      <p class="eyebrow">The team</p>
      <h2 id="team-title">You'll always deal with a name you recognise</h2>
      <p class="lead">
        Our size means you'll always deal with someone who knows both you and your business. Everyone in the team is a
        FreeAgent Accredited Practitioner. Choose a face to find out a little more.
      </p>
    </div>

    <div class="team-x__grid" data-reveal>
      <ul class="team-x__faces">
        {team.map((m, i) => (
          <li>
            <button
              type="button"
              class="team-x__face"
              data-member={m.slug}
              aria-pressed={i === 0 ? 'true' : 'false'}
              aria-controls={`member-${m.slug}`}
            >
              <Image src={m.photo} width={200} height={200} alt="" class="team-x__photo" />
              <span class="team-x__name">{m.name}</span>
              <span class="team-x__role">{m.role}</span>
            </button>
          </li>
        ))}
      </ul>

      <div class="team-x__panel">
        {team.map((m, i) => (
          <article id={`member-${m.slug}`} class="team-x__detail" data-member={m.slug} hidden={i !== 0}>
            <div class="team-x__head">
              <Image src={m.photo} width={320} height={320} alt={m.name} class="team-x__detail-photo" />
              <div>
                <h3 class="team-x__detail-name">
                  {m.name}{m.letters && <span class="team-x__letters"> {m.letters}</span>}
                </h3>
                <p class="team-x__detail-role">{m.role}</p>
              </div>
            </div>
            <div class="team-x__bio">
              {m.bio.map((p) => <p>{p}</p>)}
            </div>
            <div class="team-x__links">
              <a class="btn btn--small" href={`mailto:${m.email}`}>Email {m.name.split(' ')[0]}</a>
              {m.calendly?.video && <a class="btn btn--small btn--outline" href={m.calendly.video} rel="noopener">Book a video call</a>}
              {m.calendly?.phone && <a class="btn btn--small btn--outline" href={m.calendly.phone} rel="noopener">Book a phone call</a>}
              {m.phone && <a class="team-x__text-link" href={`tel:${m.phone.replace(/\s/g, '')}`}>{m.phone}</a>}
              {m.linkedin && <a class="team-x__text-link" href={m.linkedin} rel="noopener">LinkedIn</a>}
            </div>
          </article>
        ))}
      </div>
    </div>
    <p class="team-x__more"><a href="/about">More about the team and our clients</a></p>
  </div>
</section>

<script>
  import { onPage } from '../lib/on-page';

  // Re-runs for every page the ClientRouter swaps in (elements are fresh each time, so nothing binds twice).
  onPage(() => {
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('.team-x__face')];
    const details = [...document.querySelectorAll<HTMLElement>('.team-x__detail')];
    const panel = document.querySelector<HTMLElement>('.team-x__panel');
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const id = b.dataset.member;
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        details.forEach((d) => (d.hidden = d.dataset.member !== id));
        panel?.classList.remove('is-swapping');
        void panel?.offsetWidth;
        panel?.classList.add('is-swapping');
        if (panel && window.matchMedia('(max-width: 899px)').matches) {
          panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      })
    );
  });
</script>

<style>
  .team-x__grid { display: grid; gap: 2rem; }
  @media (min-width: 900px) {
    .team-x__grid { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); column-gap: clamp(2rem, 4vw, 4rem); align-items: start; }
  }
  .team-x__faces { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
  @media (min-width: 540px) { .team-x__faces { grid-template-columns: repeat(4, 1fr); } }
  .team-x__face {
    width: 100%; display: flex; flex-direction: column; align-items: center; text-align: center;
    padding: 0.9rem 0.5rem 1rem; border: 1px solid transparent; border-radius: var(--radius);
    background: transparent; font: inherit; color: var(--ink); cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .team-x__face:hover { background: var(--surface); border-color: var(--line); transform: translateY(-2px); }
  .team-x__face[aria-pressed="true"] { background: var(--surface); border-color: var(--green); }
  .team-x__photo { width: 100%; max-width: 104px; aspect-ratio: 1; height: auto; border-radius: 30%; object-fit: cover; margin-bottom: 0.7rem; }
  .team-x__face[aria-pressed="true"] .team-x__photo { box-shadow: 0 0 0 3px var(--surface), 0 0 0 5px var(--green); }
  .team-x__name { display: block; font-weight: 640; line-height: 1.2; font-size: 0.95rem; }
  .team-x__role { display: block; margin-top: 0.15rem; font-size: 0.8rem; color: var(--ink-3); }

  .team-x__panel { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: clamp(1.4rem, 3vw, 2.25rem); }
  .team-x__panel.is-swapping .team-x__detail { animation: fade 0.35s ease both; }
  @keyframes fade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .team-x__head { display: flex; align-items: center; gap: 1.1rem; margin-bottom: 1.1rem; }
  .team-x__detail-photo { width: 88px; height: 88px; border-radius: 30%; object-fit: cover; flex-shrink: 0; }
  .team-x__detail-name { margin: 0 0 0.2rem; font-family: var(--display); font-size: 1.6rem; font-weight: 500; line-height: 1.1; }
  .team-x__letters { font-family: var(--font); font-size: 0.9rem; font-weight: 600; color: var(--ink-3); letter-spacing: 0.02em; }
  .team-x__detail-role { margin: 0; color: var(--green); font-weight: 600; }
  .team-x__bio p { color: var(--ink-2); font-size: 0.98rem; }
  .team-x__links { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1rem; margin-top: 1.25rem; padding-top: 1.1rem; border-top: 1px solid var(--line); }
  .team-x__text-link { font-weight: 600; }
  .team-x__more { margin-top: 1.75rem; }
  @media (prefers-reduced-motion: reduce) {
    .team-x__face:hover { transform: none; }
    .team-x__panel.is-swapping .team-x__detail { animation: none; }
  }
</style>
