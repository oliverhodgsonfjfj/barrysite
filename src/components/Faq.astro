---
import { faqs } from '../data/faq';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a.map((p) => (p.lead ? `${p.lead} ${p.text}` : p.text)).join('\n\n'),
    },
  })),
};
---
<section class="section faq" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <div data-reveal>
      <p class="eyebrow">Questions</p>
      <h2 id="faq-title">The questions most new clients ask</h2>
      <p class="lead">A few of the things that come up in almost every first meeting. <a href="/faq">See all our answers</a>.</p>
    </div>
    <div class="faq__list" data-reveal>
      {faqs.map((f) => (
        <details class="faq__item" name="faq">
          <summary>
            <span>{f.q}</span>
            <span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="faq__body">
            {f.a.map((p) => (
              <p>
                {p.lead && <strong>{p.lead} </strong>}{p.text}
                {p.link && <> <a href={p.link.href} rel="noopener">{p.link.label}</a>.</>}
              </p>
            ))}
          </div>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
</section>

<style>
  .faq__grid { display: grid; gap: 2rem; }
  @media (min-width: 900px) {
    .faq__grid { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); column-gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  }
  .faq__item { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); margin-bottom: 0.6rem; }
  .faq__item[open] { border-color: var(--green); }
  .faq__item summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 1.1rem 1.25rem; cursor: pointer; list-style: none; font-weight: 640; font-size: 1.05rem;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary:hover { color: var(--green); }
  .faq__icon { position: relative; flex-shrink: 0; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--sage-2); }
  .faq__icon::before, .faq__icon::after { content: ""; position: absolute; left: 50%; top: 50%; background: var(--green); transform: translate(-50%, -50%); transition: transform 0.2s ease; }
  .faq__icon::before { width: 10px; height: 2px; }
  .faq__icon::after { width: 2px; height: 10px; }
  .faq__item[open] .faq__icon::after { transform: translate(-50%, -50%) rotate(90deg); }
  .faq__body { padding: 0 1.25rem 1.25rem; }
  .faq__body p { color: var(--ink-2); font-size: 0.98rem; }
</style>
