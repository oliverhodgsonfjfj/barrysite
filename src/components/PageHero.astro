---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  image?: string; // public path
  imageAlt?: string;
  compact?: boolean;
}
const { eyebrow, title, intro, image, imageAlt = '', compact = false } = Astro.props;
---
<section class:list={['page-hero', { 'page-hero--image': !!image, 'page-hero--compact': compact }]}>
  {image && <img class="page-hero__img" src={image} alt={imageAlt} loading="eager" fetchpriority="high" />}
  {image && <div class="page-hero__scrim" aria-hidden="true"></div>}
  <div class="container page-hero__inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {intro && <p class="lead page-hero__intro">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero { position: relative; padding-block: clamp(3rem, 8vw, 6rem) clamp(2.5rem, 6vw, 4.5rem); border-bottom: 1px solid var(--line); }
  .page-hero--compact { padding-block: clamp(2.5rem, 6vw, 4rem) clamp(2rem, 4vw, 3rem); }
  .page-hero__inner { position: relative; z-index: 2; max-width: var(--container); }
  .page-hero h1 { max-width: 18ch; }
  .page-hero__intro { max-width: 60ch; }
  .page-hero--image { min-height: 52vh; display: flex; align-items: flex-end; color: #fff; border-bottom: 0; padding-top: 9rem; }
  .page-hero--image .eyebrow { color: #fff; }
  .page-hero--image .eyebrow::before { border-right-color: #fff; }
  .page-hero--image h1 { color: #fff; }
  .page-hero--image .page-hero__intro { color: rgba(255, 255, 255, 0.9); }
  .page-hero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .page-hero__scrim { position: absolute; inset: 0; background: linear-gradient(to top, rgba(10, 25, 5, 0.85) 0%, rgba(10, 25, 5, 0.35) 55%, rgba(10, 25, 5, 0.25) 100%); }

  /* Entrance: eyebrow, h1, intro and anything slotted after them rise in 80ms apart, and the
     photo settles from a slight zoom. Keyframes and --ease are shared with the home hero
     (global.css). :global() so the rule also reaches slotted content from the page. */
  @media (prefers-reduced-motion: no-preference) {
    .page-hero__inner > :global(*) { animation: rise var(--rise-time) var(--ease) both; animation-delay: calc(0.1s + var(--i, 0) * 80ms); }
    .page-hero__inner > :global(:nth-child(2)) { --i: 1; }
    .page-hero__inner > :global(:nth-child(3)) { --i: 2; }
    .page-hero__inner > :global(:nth-child(n + 4)) { --i: 3; }
    .page-hero__img { animation: hero-photo-in 1.6s var(--ease) both; }
  }
</style>
