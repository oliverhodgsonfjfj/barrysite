---
import { steps } from '../data/howItWorks';
---
<section class="section how" aria-labelledby="how-title">
  <div class="container how__grid">
    <div data-reveal>
      <p class="eyebrow">How it works</p>
      <h2 id="how-title">What working with Focus is like</h2>
      <p class="lead">We tailor our service to each client, so no two relationships are the same, but the foundations are always these.</p>
    </div>
    <div class="how__tabs" data-reveal>
      <div class="how__tablist" role="tablist" aria-label="Stages of working with Focus">
        {steps.map((s, i) => (
          <button
            type="button"
            role="tab"
            id={`how-tab-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`how-panel-${i}`}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="how__num">{i + 1}</span>
            {s.title}
          </button>
        ))}
      </div>
      {steps.map((s, i) => (
        <div role="tabpanel" id={`how-panel-${i}`} aria-labelledby={`how-tab-${i}`} class="how__panel" hidden={i !== 0}>
          <h3>{s.heading}</h3>
          {s.body.map((p) => <p>{p}</p>)}
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.how__tablist [role="tab"]')];
  const panels = [...document.querySelectorAll<HTMLElement>('.how__panel')];
  const select = (i: number) => {
    tabs.forEach((t, k) => {
      t.setAttribute('aria-selected', String(k === i));
      t.tabIndex = k === i ? 0 : -1;
    });
    panels.forEach((p, k) => (p.hidden = k !== i));
    tabs[i].focus();
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(i));
    t.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); select((i + 1) % tabs.length); }
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); select((i - 1 + tabs.length) % tabs.length); }
      if (e.key === 'Home') { e.preventDefault(); select(0); }
      if (e.key === 'End') { e.preventDefault(); select(tabs.length - 1); }
    });
  });
</script>

<style>
  .how__grid { display: grid; gap: 2rem; }
  @media (min-width: 900px) {
    .how__grid { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); column-gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  }
  .how__tabs { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; }
  .how__tablist { display: flex; gap: 0.25rem; padding: 0.6rem; border-bottom: 1px solid var(--line); overflow-x: auto; scrollbar-width: none; }
  @media (min-width: 700px) { .how__tablist { flex-wrap: wrap; overflow: visible; } }
  .how__tablist::-webkit-scrollbar { display: none; }
  .how__tablist [role="tab"] {
    display: inline-flex; align-items: center; gap: 0.55rem; flex-shrink: 0;
    padding: 0.6rem 1rem 0.6rem 0.6rem; border: 0; border-radius: var(--pill); background: transparent;
    font: inherit; font-weight: 600; font-size: 0.92rem; color: var(--ink-2); cursor: pointer; white-space: nowrap;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .how__tablist [role="tab"]:hover { background: var(--sage-2); color: var(--ink); }
  .how__tablist [role="tab"][aria-selected="true"] { background: var(--green); color: #fff; }
  .how__num {
    display: inline-grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%;
    background: var(--sage-2); color: var(--green); font-size: 0.8rem; font-weight: 650;
  }
  [role="tab"][aria-selected="true"] .how__num { background: rgba(255, 255, 255, 0.18); color: #fff; }
  .how__panel { padding: clamp(1.4rem, 3.5vw, 2.5rem); animation: fade 0.35s ease both; }
  .how__panel h3 { font-family: var(--display); font-size: 1.55rem; font-weight: 500; margin-bottom: 0.7rem; }
  .how__panel p { color: var(--ink-2); }
  @keyframes fade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .how__panel { animation: none; } }
</style>
