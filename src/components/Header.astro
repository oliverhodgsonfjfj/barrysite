---
import { site, nav } from '../data/site';

interface Props { current?: string; overlay?: boolean }
const { current, overlay = false } = Astro.props;
const links = nav;
const isCurrent = (item: { href: string; children?: { href: string }[] }) => current === item.href || !!item.children?.some((c) => c.href === current);
---
<header class:list={['site-header', { 'site-header--overlay': overlay }]} data-header style="--p:0">
  <div class="site-header__row">
    <div class="site-header__bar">
      <a class="brand" href="/" aria-label="Focus Accountancy, home">
        <img class="brand__colour" src="/img/logo.png" alt="Focus Accountancy Ltd" width="5279" height="2618" decoding="async" fetchpriority="high" />
        <img class="brand__white" src="/img/logo-white.png" alt="" aria-hidden="true" width="1200" height="595" decoding="async" fetchpriority="high" />
      </a>
      <nav class="site-header__nav" aria-label="Main">
        <ul>
          {links.map((item) => (
            <li class:list={{ 'has-menu': !!item.children }}>
              <a href={item.href} aria-current={isCurrent(item) ? 'page' : undefined} aria-haspopup={item.children ? 'true' : undefined}>
                {item.label}{item.children && <svg class="nav-caret" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>}
              </a>
              {item.children && (
                <ul class:list={['nav-menu', { 'nav-menu--wide': item.children.length > 5 }]}>
                  {item.children.map((c) => (
                    <li><a href={c.href} rel={c.external ? 'noopener' : undefined} aria-current={current === c.href ? 'page' : undefined}>{c.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>
      <a class="site-header__cta" href={site.calendly.barry} rel="noopener">Book a free meeting</a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
        <span class="nav-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div id="site-nav" class="mnav" inert>
    <nav class="mnav__inner" aria-label="Main">
      <ul class="mnav__list">
        {links.map((item, i) => {
          // In the sheet a parent opens its group rather than navigating, so make sure its own page is in the list.
          const kids = item.children && (item.children.some((c) => c.href === item.href) ? item.children : [{ href: item.href, label: `All ${item.label.toLowerCase()}` }, ...item.children]);
          return (
            <li class="mnav__item" style={`--i:${i}`}>
              {kids ? (
                <details class="mnav__group" name="mnav" open={isCurrent(item) || undefined}>
                  <summary class="mnav__link">
                    <span>{item.label}</span>
                    <svg class="mnav__chev" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M4.5 7 9 11.5 13.5 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </summary>
                  <ul class="mnav__sub">
                    {kids.map((c) => (
                      <li><a href={c.href} rel={c.external ? 'noopener' : undefined} aria-current={current === c.href ? 'page' : undefined}>{c.label}{c.external && <span class="mnav__ext" aria-hidden="true">↗</span>}</a></li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a class="mnav__link" href={item.href} aria-current={current === item.href ? 'page' : undefined}>
                  <span>{item.label}</span>
                  <svg class="mnav__arrow" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              )}
            </li>
          );
        })}
      </ul>
      <div class="mnav__foot" style={`--i:${links.length}`}>
        <a class="btn mnav__cta" href={site.calendly.barry} rel="noopener">Book a free meeting</a>
        <p class="mnav__contact">
          <a href={site.phoneHref}>{site.phone}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <a class="mnav__portal" href={site.portal} rel="noopener">Client Portal login <span aria-hidden="true">↗</span></a>
      </div>
    </nav>
  </div>
</header>

<script>
  import { onPage } from '../lib/on-page';

  // One scroll listener for the session; `header` is re-pointed at each page's header by onPage,
  // so nothing is bound twice under ClientRouter navigation.
  let header: HTMLElement | null = null;
  const update = () => {
    if (!header) return;
    const p = Math.min(1, Math.max(0, (window.scrollY - 20) / 260));
    header.style.setProperty('--p', p.toFixed(3));
    header.classList.toggle('is-scrolled', p > 0.5);
  };
  window.addEventListener('scroll', update, { passive: true });

  // Mobile sheet. Open: page scroll locked, sheet un-inerted, focus moves into it. Closes on Esc, on any
  // link inside it, and when the window grows to the desktop layout. Focus goes back to the button.
  const desktop = window.matchMedia('(min-width: 1000px)');
  let setMenu: (open: boolean, restoreFocus?: boolean) => void = () => {};
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false, true); });
  desktop.addEventListener('change', (e) => { if (e.matches) setMenu(false); });

  onPage(() => {
    header = document.querySelector<HTMLElement>('[data-header]');
    const btn = document.querySelector<HTMLButtonElement>('.nav-toggle');
    const sheet = document.getElementById('site-nav');
    document.documentElement.classList.remove('menu-lock');
    setMenu = (open, restoreFocus = false) => {
      if (!btn || !sheet || !header) return;
      if (open === header.classList.contains('is-menu-open')) return;
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      header.classList.toggle('is-menu-open', open);
      document.documentElement.classList.toggle('menu-lock', open);
      sheet.inert = !open;
      if (open) sheet.querySelector<HTMLElement>('.mnav__link')?.focus({ preventScroll: true });
      else if (restoreFocus) btn.focus();
    };
    btn?.addEventListener('click', () => setMenu(btn.getAttribute('aria-expanded') !== 'true'));
    sheet?.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) setMenu(false); });
    update();
  });
</script>

<style>
  .site-header { position: fixed; top: 0; left: 0; right: 0; z-index: 40; padding: 0 var(--gutter); pointer-events: none; }
  .site-header__row { position: relative; display: flex; justify-content: center; align-items: center; max-width: var(--container); margin: 0 auto; padding-top: calc(12px * var(--p)); }

  /* Bar: full width on landing, morphs into a centred pill as --p goes 0 -> 1 */
  .site-header__bar {
    pointer-events: auto;
    display: flex; align-items: center; gap: 1rem;
    width: min(100%, calc(100% - (100% - 960px) * var(--p)));
    min-height: calc(84px - 26px * var(--p));
    padding: 0 calc(6px * var(--p)) 0 calc(4px + 14px * var(--p));
    background: rgba(255, 255, 255, var(--p));
    border: 1px solid rgba(20, 31, 16, calc(0.09 * var(--p)));
    border-radius: calc(48px * var(--p));
    box-shadow: 0 14px 34px -18px rgba(20, 31, 16, calc(0.5 * var(--p)));
    color: var(--ink);
    transition: color 0.3s ease;
  }
  .site-header--overlay:not(.is-scrolled):not(.is-menu-open) .site-header__bar { color: #fff; }
  .site-header:not(.site-header--overlay) .site-header__bar { background: #fff; border-color: rgba(20, 31, 16, 0.09); }
  .site-header.is-menu-open .site-header__bar { background: #fff; color: var(--ink); }

  .brand { position: relative; display: flex; align-items: center; flex-shrink: 0; margin-right: auto; }
  .brand img { height: calc(60px - 22px * var(--p)); width: auto; }
  .brand__white { display: none; position: absolute; inset: 0; opacity: 0; transition: opacity 0.25s ease; filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.45)) drop-shadow(0 6px 16px rgba(0, 0, 0, 0.35)); }
  .site-header--overlay .brand__white { display: block; }
  .site-header--overlay:not(.is-scrolled):not(.is-menu-open) .brand__white { opacity: 1; }
  .site-header--overlay:not(.is-scrolled):not(.is-menu-open) .brand__colour { opacity: 0; }
  .brand__colour { transition: opacity 0.25s ease; }
  
  .site-header__nav { display: none; }
  .site-header__nav > ul { display: flex; gap: 0.15rem; list-style: none; margin: 0; padding: 0; }
  .site-header__nav a { position: relative; display: inline-block; white-space: nowrap; padding: 0.5rem 0.7rem; color: inherit; font-weight: 540; font-size: 0.94rem; text-decoration: none; transition: color 0.2s ease; }
  .is-scrolled .site-header__nav a:hover, .site-header:not(.site-header--overlay) .site-header__nav a:hover { color: var(--green); }
  /* Underline slides in from the left on hover and out to the right on leave (transform-origin
     swaps with the state); the current page keeps it drawn. */
  .site-header__nav a::after {
    content: ""; position: absolute; left: 0.7rem; right: 0.7rem; bottom: 0.25rem; height: 1.5px;
    background: currentColor; transform: scaleX(0); transform-origin: right; transition: transform 0.35s var(--ease);
  }
  .site-header__nav a:hover::after, .site-header__nav a:focus-visible::after, .site-header__nav a[aria-current="page"]::after { transform: scaleX(1); transform-origin: left; }
  @media (prefers-reduced-motion: reduce) { .site-header__nav a::after { transition: none; } }
  .site-header__nav > ul > li { position: relative; }
  .nav-caret { display: inline-block; margin-left: 0.25rem; vertical-align: 1px; opacity: 0.6; transition: transform 0.25s var(--ease); }
  .has-menu:hover .nav-caret, .has-menu:focus-within .nav-caret { transform: rotate(180deg); }
  /* Dropdown: a compact card under the link. Opens on hover and on keyboard focus within;
     the ::before strip bridges the gap so the pointer can travel down without it closing. */
  .nav-menu {
    display: grid; position: absolute; top: calc(100% + 6px); left: 0.35rem; z-index: 50;
    margin: 0; padding: 0.4rem; list-style: none; gap: 0;
    background: #fff; color: var(--ink); border: 1px solid rgba(20, 31, 16, 0.08); border-radius: 14px;
    box-shadow: 0 20px 44px -20px rgba(20, 31, 16, 0.4), 0 2px 6px -2px rgba(20, 31, 16, 0.12);
    opacity: 0; visibility: hidden; transform: translateY(4px) scale(0.98); transform-origin: top left;
    transition: opacity 0.18s ease, transform 0.22s var(--ease), visibility 0s linear 0.18s;
  }
  .nav-menu::before { content: ""; position: absolute; left: 0; right: 0; top: -12px; height: 12px; }
  .has-menu:hover > .nav-menu, .has-menu:focus-within > .nav-menu { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  .nav-menu--wide { grid-template-columns: repeat(2, minmax(150px, 1fr)); column-gap: 0.25rem; }
  .site-header__nav > ul > li:last-child > .nav-menu { left: auto; right: 0.35rem; transform-origin: top right; }
  .nav-menu li a { display: block; padding: 0.42rem 0.75rem; border-radius: 8px; font-size: 0.88rem; font-weight: 500; line-height: 1.25; color: var(--ink); white-space: nowrap; }
  .nav-menu li a::after { display: none; }
  .nav-menu li a:hover, .nav-menu li a:focus-visible { color: var(--green); background: var(--sage-2, #eef4ea); }
  .nav-menu li a[aria-current="page"] { color: var(--green); font-weight: 650; }
  .nav-menu li a[rel="noopener"]::before { content: "↗"; float: right; margin-left: 0.6rem; font-size: 0.75em; opacity: 0.5; }
  @media (prefers-reduced-motion: reduce) { .nav-menu, .nav-caret { transition: none; } }

  /* CTA sits outside the bar, pinned to the right edge of the container */
  .site-header__cta {
    display: none; flex-shrink: 0; align-items: center; margin-left: 0.5rem; padding: 0.72rem 1.2rem; border-radius: 999px;
    background: var(--green); color: #fff; font-weight: 620; font-size: 0.95rem; text-decoration: none; white-space: nowrap;
    box-shadow: 0 10px 24px -14px rgba(11, 63, 0, 0.7); transition: background-color 0.15s ease, transform 0.15s ease;
  }
  .site-header__cta:hover { background: var(--green-deep); color: #fff; }
  .site-header__cta--inline { display: inline-flex; margin-left: 0; }

  .nav-toggle { position: relative; z-index: 2; display: inline-grid; place-items: center; flex-shrink: 0; width: 44px; height: 44px; margin-right: 8px; border: 1px solid rgba(255, 255, 255, 0.35); border-radius: 50%; background: rgba(255, 255, 255, 0.12); color: inherit; cursor: pointer; transition: background-color 0.25s ease, color 0.25s ease; }
  .is-scrolled .nav-toggle, .is-menu-open .nav-toggle, .site-header:not(.site-header--overlay) .nav-toggle { background: var(--sage-2); border-color: transparent; color: var(--green); }
  .site-header.is-menu-open .nav-toggle { background: var(--green); color: #fff; }
  .nav-toggle__bars { position: relative; display: block; width: 18px; height: 14px; }
  .nav-toggle__bars span { position: absolute; left: 0; width: 100%; height: 2px; border-radius: 2px; background: currentColor; transition: transform 0.35s var(--ease), opacity 0.2s ease, top 0.35s var(--ease); }
  .nav-toggle__bars span:nth-child(1) { top: 0; }
  .nav-toggle__bars span:nth-child(2) { top: 6px; }
  .nav-toggle__bars span:nth-child(3) { top: 12px; }
  .is-menu-open .nav-toggle__bars span:nth-child(1) { top: 6px; transform: rotate(45deg); }
  .is-menu-open .nav-toggle__bars span:nth-child(2) { opacity: 0; transform: scaleX(0.3); }
  .is-menu-open .nav-toggle__bars span:nth-child(3) { top: 6px; transform: rotate(-45deg); }

  /* Full-screen sheet behind the bar */
  .site-header__row { z-index: 2; }
  :global(html.menu-lock), :global(html.menu-lock body) { overflow: hidden; }
  .mnav {
    position: fixed; inset: 0; z-index: 1; pointer-events: auto; overflow-y: auto; overscroll-behavior: contain;
    padding: calc(84px + 1rem) var(--gutter) max(1.5rem, env(safe-area-inset-bottom));
    background: var(--paper); color: var(--ink);
    opacity: 0; visibility: hidden; transform: translateY(-8px);
    transition: opacity 0.3s ease, transform 0.45s var(--ease), visibility 0s linear 0.45s;
    interpolate-size: allow-keywords;
  }
  .is-menu-open .mnav { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  .mnav__inner { display: flex; flex-direction: column; min-height: 100%; max-width: 560px; margin: 0 auto; }
  .mnav__list { list-style: none; margin: 0; padding: 0; }
  .mnav__item { border-bottom: 1px solid var(--line); }
  .mnav__link {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 64px; padding: 0.5rem 0;
    font-family: var(--display); font-size: 1.45rem; font-weight: 540; letter-spacing: -0.01em; color: var(--ink); text-decoration: none; cursor: pointer; list-style: none;
  }
  .mnav__link::-webkit-details-marker { display: none; }
  .mnav__link[aria-current="page"], .mnav__group[open] > .mnav__link { color: var(--green); }
  .mnav__chev, .mnav__arrow { flex-shrink: 0; color: var(--green); transition: transform 0.35s var(--ease); }
  .mnav__group[open] .mnav__chev { transform: rotate(180deg); }
  .mnav__link:hover .mnav__arrow { transform: translateX(3px); }
  .mnav__group::details-content { block-size: 0; overflow: hidden; transition: block-size 0.4s var(--ease), content-visibility 0.4s allow-discrete; }
  .mnav__group[open]::details-content { block-size: auto; }
  .mnav__sub { list-style: none; margin: 0; padding: 0 0 1rem; display: grid; gap: 0.1rem; }
  .mnav__sub a { display: flex; align-items: center; gap: 0.5rem; min-height: 44px; padding: 0 0.9rem; border-radius: 12px; color: var(--ink-2); font-size: 1.05rem; font-weight: 500; text-decoration: none; }
  .mnav__sub a:hover, .mnav__sub a[aria-current="page"] { background: var(--sage-2); color: var(--green); }
  .mnav__ext { font-size: 0.8em; opacity: 0.55; }
  .mnav__foot { margin-top: auto; padding-top: 2rem; display: grid; gap: 1rem; }
  .mnav__cta { justify-content: center; width: 100%; padding-block: 0.95rem; }
  .mnav__contact { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1rem; margin: 0; font-weight: 600; }
  .mnav__contact a { color: var(--ink); text-decoration: none; }
  .mnav__portal { font-size: 0.95rem; color: var(--ink-3); }
  /* The bar's own CTA hides on phones; the sheet's sits at the bottom instead. */
  @media (min-width: 720px) { .mnav__cta { display: none; } }

  /* Items rise in 40ms apart as the sheet opens */
  @media (prefers-reduced-motion: no-preference) {
    .mnav__item, .mnav__foot { opacity: 0; transform: translateY(14px); transition: opacity 0.35s ease, transform 0.55s var(--ease); }
    .is-menu-open .mnav__item, .is-menu-open .mnav__foot { opacity: 1; transform: none; transition-delay: calc(0.08s + var(--i, 0) * 40ms); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mnav, .mnav__group::details-content, .nav-toggle__bars span { transition: none; }
  }

  @media (min-width: 720px) {
    .site-header__cta { display: inline-flex; }
  }
  @media (min-width: 1000px) {
    .site-header__nav { display: flex; }
    .nav-toggle, .mnav { display: none !important; }
  }
</style>
