---
// The hero's pale green "Book a free meeting" button, floating bottom-right on every page (Barry, Nov 2026).
// It appears once the visitor scrolls past the first screen, so it never doubles up with the hero's own button.
// The href is site.bookMeeting, so Base.astro's click handler opens the Barry/Greg/Maria chooser.
import { site } from '../data/site';

interface Props { current?: string }
const { current } = Astro.props;
const onBookingPage = current === site.bookMeeting || Astro.url.pathname.replace(/\.html$/, '') === site.bookMeeting;
const arrow = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>';
---
{!onBookingPage && (
  <a class="float-cta" href={site.bookMeeting} data-float-cta>
    <span class="float-cta__label">Book a free meeting</span>
    <span class="float-cta__arrow">
      <span class="float-cta__icon" set:html={arrow} />
      <span class="float-cta__icon float-cta__icon--next" set:html={arrow} />
    </span>
  </a>
)}

<script>
  import { onPage } from '../lib/on-page';

  // One scroll listener for the session; `cta` is re-pointed at each page's button by onPage.
  let cta: HTMLElement | null = null;
  const update = () => cta?.classList.toggle('is-shown', window.scrollY > window.innerHeight * 0.6);
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
  onPage(() => {
    cta = document.querySelector<HTMLElement>('[data-float-cta]');
    update();
  });
</script>

<style>
  /* One lime capsule with the dark green arrow disc set inside it. A hairline ring keeps the edge
     crisp on white sections; the two-layer shadow lifts it without a grey halo. */
  .float-cta {
    position: fixed; z-index: 34; right: 24px; bottom: 24px;
    display: inline-flex; align-items: center; gap: 0.9rem;
    padding: 6px 6px 6px 1.4rem;
    text-decoration: none; color: var(--green-ink);
    background: var(--lime); border-radius: var(--pill);
    box-shadow:
      0 0 0 1px rgb(10 43 0 / 0.1),
      0 2px 4px rgb(10 43 0 / 0.1),
      0 12px 28px -10px rgb(10 43 0 / 0.35);
    opacity: 0; visibility: hidden; transform: translateY(16px);
    transition: opacity 0.35s ease, transform 0.5s var(--ease), box-shadow 0.3s ease, background-color 0.3s ease, visibility 0s linear 0.5s;
  }
  .float-cta.is-shown { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  .float-cta.is-shown:hover {
    transform: translateY(-2px);
    background: #c8eab3;
    box-shadow:
      0 0 0 1px rgb(10 43 0 / 0.12),
      0 3px 6px rgb(10 43 0 / 0.12),
      0 18px 36px -12px rgb(10 43 0 / 0.4);
  }
  /* Without JS there's no scroll check, so just show it. */
  :global(html:not(.js)) .float-cta { opacity: 1; visibility: visible; transform: none; }
  /* Sit above the promotion bar while it's showing. */
  :global(body:has(.promo:not([hidden]))) .float-cta { bottom: 96px; }

  .float-cta__label { font-weight: 600; font-size: 1rem; letter-spacing: -0.005em; white-space: nowrap; }
  .float-cta__arrow {
    position: relative; display: grid; place-items: center; flex: none; width: 44px; height: 44px;
    overflow: hidden; border-radius: 50%; background: var(--green-ink); color: var(--lime);
  }
  .float-cta__icon { position: absolute; display: grid; transition: transform 0.45s var(--ease); }
  .float-cta__icon--next { transform: translate(-28px, 28px); }
  .float-cta:hover .float-cta__icon { transform: translate(28px, -28px); }
  .float-cta:hover .float-cta__icon--next { transform: none; }
  .float-cta:focus-visible { outline: 2px solid var(--green); outline-offset: 3px; }

  @media (max-width: 600px) {
    .float-cta { right: 14px; bottom: 14px; gap: 0.7rem; padding-left: 1.15rem; }
    .float-cta__label { font-size: 0.95rem; }
    .float-cta__arrow { width: 40px; height: 40px; }
    :global(body:has(.promo:not([hidden]))) .float-cta { bottom: 150px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .float-cta, .float-cta__icon { transition: none; }
    .float-cta, .float-cta.is-shown:hover { transform: none; }
  }
</style>
