---
// The live Wix /resources page: a heading, four quick links, an intro, the category menu and the
// post feed. Category pages render the same shell filtered. Guides and the news site follow below.
import PageHero from './PageHero.astro';
import PostList from './PostList.astro';
import DeadlineBar from './DeadlineBar.astro';
import { site } from '../data/site';
import { TOPICS, type Post } from '../lib/posts';

interface Props { posts: Post[]; all: Post[]; active?: string }
const { posts, all, active } = Astro.props;
const counts = Object.fromEntries(Object.keys(TOPICS).map((t) => [t, all.filter((p) => p.data.topics.includes(t)).length]));
const quick = [
  { href: '/taxes', label: 'Pay taxes' },
  { href: '/jargon-buster', label: 'Jargon buster' },
  { href: '/faq', label: "FAQ's" },
  { href: '/client-portal', label: 'Client Portal' },
];
const guides = [
  { href: '/taxes', label: 'Paying your taxes', note: 'Deadlines, payment links, bank details and what happens if you pay late.' },
  { href: '/ir35', label: 'IR35', note: 'What it is, how status is decided, and a free independent review.' },
  { href: '/banking', label: 'Banking', note: 'Choosing a business bank account, and the banks we partner with.' },
  { href: '/insurance', label: 'Insurance', note: 'Contractor insurance and IR35 reviews with Kingsbridge.' },
  { href: '/pensions', label: 'Pensions', note: 'Setting up director or personal pension contributions.' },
  { href: '/legal', label: 'Legal', note: 'The Bristol law firm we recommend.' },
  { href: '/jargon-buster', label: 'Jargon buster', note: 'Accounting terms explained, A to Z.' },
  { href: '/faq', label: 'Frequently asked questions', note: 'The questions most new clients ask us.' },
  { href: '/client-portal', label: 'The client portal', note: 'How our secure document portal works.' },
  { href: '/freeagent', label: 'FreeAgent help', note: 'Tips, videos, webinars and answers for FreeAgent users.' },
];
---
<PageHero eyebrow="Resources" title={active ? `${TOPICS[active]} articles` : 'Resources'} compact>
  <p class="resources__quick">
    {quick.map((q) => <a class="btn btn--outline btn--small" href={q.href}>{q.label}</a>)}
  </p>
  <p class="lead resources__intro">
    We regularly write articles on a wide range of relevant topics so that contractors, consultants and freelancers can be
    better informed to make the right choices. <a href={site.social.twitter} rel="noopener">Follow us on Twitter</a> to stay up
    to date with the latest posts or browse the archive below.
  </p>
</PageHero>

<section class="section section--tight" id="posts">
  <div class="container">
    <nav class="post-topics" aria-label="Post categories" data-reveal>
      <a class:list={['post-topics__chip', { 'is-active': !active }]} href="/resources">All Posts ({all.length})</a>
      {Object.entries(TOPICS).filter(([k]) => counts[k] > 0).map(([k, l]) => (
        <a class:list={['post-topics__chip', { 'is-active': k === active }]} href={`/resources/categories/${k}`}>{l} ({counts[k]})</a>
      ))}
    </nav>
    <PostList posts={posts} />
  </div>
</section>

<DeadlineBar />

<section class="section section--tight">
  <div class="container" data-reveal-stagger>
    <p class="eyebrow">Guides</p>
    <h2 class="page-section-title">Our guides</h2>
    <ul class="link-grid link-grid--3">
      {guides.map((g) => (
        <li><a href={g.href}>{g.label}<span class="small muted">{g.note}</span></a></li>
      ))}
    </ul>
  </div>
</section>

<section class="section section--tight">
  <div class="container cards cards--3" data-reveal-stagger>
    <div class="card">
      <p class="eyebrow">News</p>
      <h3 class="card__title">News site</h3>
      <p>Budgets, tax changes and business news on our news site.</p>
      <p><a class="btn btn--outline btn--small" href={site.news} rel="noopener">Read the news</a></p>
    </div>
    <div class="card">
      <p class="eyebrow">Factsheets</p>
      <h3 class="card__title">Reference factsheets</h3>
      <p>Plain-English factsheets on tax and business topics, kept up to date each tax year.</p>
      <p><a class="btn btn--outline btn--small" href={site.factsheets} rel="noopener">Browse factsheets</a></p>
    </div>
    <div class="card">
      <p class="eyebrow">Infozone</p>
      <h3 class="card__title">Tax rates and calculators</h3>
      <p>Current rates, allowances and thresholds, plus useful calculators.</p>
      <p><a class="btn btn--outline btn--small" href={site.infozone} rel="noopener">Open the infozone</a></p>
    </div>
  </div>
</section>

<section class="section section--tight">
  <div class="container grid grid--7-5" data-reveal>
    <div class="card">
      <p class="eyebrow">Tax planning</p>
      <h3 class="card__title">Tax planning for 2025 to 2026</h3>
      <p>Tax planning is an easy way to save yourself thousands in taxes every year. This document has all the information you need about tax planning for the 2025 to 2026 tax year.</p>
      <p><a class="btn btn--small" href="/docs/tax-planning-2025-26.pdf">Download the guide (PDF)</a></p>
    </div>
    <div class="card">
      <p class="eyebrow">The Focus App</p>
      <p>Tax tips, up-to-date tax rates and calculators to help with decisions like 'should I get a company car?' or 'should I be a sole trader or a limited company?'.</p>
      <p><a class="btn btn--outline btn--small" href={site.googlePlay} rel="noopener">Get it on Google Play</a></p>
    </div>
  </div>
</section>

<style is:global>
  .resources__quick { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.25rem 0 0; }
  .resources__intro { margin-top: 1.25rem; max-width: 62ch; }
</style>
